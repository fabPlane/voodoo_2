+++ b/emu/test/ref_model.c
@@ -411,6 +411,21 @@ void voodoo_recalc(voodoo_t *voodoo)
     voodoo->params.row_width      = voodoo->row_width;
     voodoo->aux_row_width         = voodoo->row_width;
     voodoo->params.aux_row_width  = voodoo->row_width;
+
+    /*
+     * Glide programs SST_videoDimensions before drawing, and the rasteriser's
+     * Y-origin flip is (v_disp - 1) - y. A trace that starts after that init
+     * write leaves v_disp at 0, so the flip sends every pixel to a negative
+     * row. The masked address then walks out of the depth buffer into the
+     * back colour buffer (GLQuake gl_ztrick GEQUAL frames show Z as colour).
+     * The colour buffer is buffer_offset bytes tall; use that as the screen
+     * when the register was never captured.
+     */
+    if (voodoo->videoDimensions == 0 && voodoo->row_width > 0 &&
+        buffer_offset >= voodoo->row_width) {
+        voodoo->h_disp = (int) (voodoo->row_width / 2);
+        voodoo->v_disp = (int) (buffer_offset / voodoo->row_width);
+    }
 }
 
