-  0xFFFFFFFF,                      /* invalid */
+  /*
+   * Index 0 is "no mask yet". It used to be 0xFFFFFFFF, and grTexCombine
+   * ORs this entry in before grTexSource has stored a real mask. That set
+   * SST_TMULTIBASEADDR (and every other high tLOD bit). Later grTexSource
+   * keeps those bits, so every mip below LOD 0 was fetched from texture
+   * address 0. A missing mask contributes no bits.
