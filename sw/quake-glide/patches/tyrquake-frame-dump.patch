 void
 VID_Update(vrect_t *rects)
 {
+    const char *dir = getenv("QUAKE_FRAME_DIR");
+    const char *lim = getenv("QUAKE_MAX_SECONDS");
+    const byte *pal = vid_palette ? vid_palette : host_basepal;
+    char path[1024];
+    FILE *f;
+    int i;
+    static int frame;
+
+    (void)rects;
+    if (!dir || !pal)
+        return;
+
+    snprintf(path, sizeof(path), "%s/frame_%05d.ppm", dir, frame++);
+    f = fopen(path, "wb");
+    if (f) {
+        fprintf(f, "P6\n%d %d\n255\n", BASEWIDTH, BASEHEIGHT);
+        for (i = 0; i < BASEWIDTH * BASEHEIGHT; i++) {
+            const byte *c = pal + (int)vid_buffer[i] * 3;
+            fwrite(c, 1, 3, f);
+        }
+        fclose(f);
+    }
+
+    if (lim && realtime >= atof(lim))
+        Sys_Quit();
 }
 
