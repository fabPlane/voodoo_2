diff --git a/common/snd_null.c b/common/snd_null.c
index d89f99f..5810482 100644
--- a/common/snd_null.c
+++ b/common/snd_null.c
@@ -19,7 +19,24 @@ Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
 
 #include "sound.h"
 
-qboolean SNDDMA_Init(void) { return false; }
+/*
+ * Headless capture has no audio device. Pretend DMA came up so S_Init can
+ * finish (it reads shm->speed) and the software renderer still runs.
+ */
+static dma_t null_shm;
+static unsigned char null_buffer[1 << 16];
+
+qboolean SNDDMA_Init(void) {
+    null_shm.channels = 2;
+    null_shm.samples = 32768;
+    null_shm.submission_chunk = 1;
+    null_shm.samplepos = 0;
+    null_shm.samplebits = 16;
+    null_shm.speed = 22050;
+    null_shm.buffer = null_buffer;
+    shm = &null_shm;
+    return true;
+}
 int SNDDMA_GetDMAPos(void) { return 0; }
 void SNDDMA_Shutdown(void) { }
 void SNDDMA_Submit(void) { }
