+/*
+ * Mesa downloads some textures through the TMU1 PCI aperture even though
+ * this board is configured with one TMU. The register file is broadcast,
+ * so a draw names the texture by texBaseAddr alone. Remember which
+ * aperture each base was written to; the two RAMs overlap in address.
+ */
+#define TEX_APERTURE_N 512
+static uint32_t tex_aperture_base[TEX_APERTURE_N];
+static uint32_t tex_download_lod[TEX_APERTURE_N];
+static uint8_t  tex_download_fmt[TEX_APERTURE_N];
+static uint8_t  tex_aperture_tmu[TEX_APERTURE_N];
+static uint8_t  tex_aperture_used[TEX_APERTURE_N];
+static uint8_t  tex_download_valid[TEX_APERTURE_N];
+
+static int
+voodoo_tex_slot(uint32_t base, int create)
+{
+    uint32_t slot = (base >> 4) & (TEX_APERTURE_N - 1);
+
+    for (int n = 0; n < TEX_APERTURE_N; n++) {
+        uint32_t i = (slot + n) & (TEX_APERTURE_N - 1);
+
+        if (tex_aperture_used[i] && tex_aperture_base[i] == base)
+            return (int) i;
+        if (!tex_aperture_used[i]) {
+            if (!create)
+                return -1;
+            tex_aperture_used[i] = 1;
+            tex_aperture_base[i] = base;
+            return (int) i;
+        }
+    }
+    return -1;
+}
+
+static void
+voodoo_note_tex_aperture(uint32_t base, int tmu)
+{
+    int i = voodoo_tex_slot(base, 1);
+    if (i < 0)
+        return;
+    tex_aperture_tmu[i] = (uint8_t) tmu;
+}
+
+static int
+voodoo_tex_aperture(uint32_t base)
+{
+    int i = voodoo_tex_slot(base, 0);
+    if (i < 0)
+        return 0;
+    return tex_aperture_tmu[i];
+}
+
+/*
+ * Glide's draw-time tLOD/textureMode for some 2D images does not match
+ * the download that actually stored the texels (wide RGB565 status bar
+ * sampled later as a square 4444 level). Remember the download's aspect
+ * and format and apply them while this triangle is decoded.
+ * Returns 1 if params were changed; caller restores after the snapshot.
+ */
+int
+voodoo_apply_download_layout(voodoo_t *voodoo)
+{
+    uint32_t base = voodoo->params.texBaseAddr[0];
+    int      i    = voodoo_tex_slot(base, 0);
+    uint32_t draw_lod, dl_lod;
+    int      draw_fmt, dl_fmt;
+
+    if (i < 0 || !tex_download_valid[i])
+        return 0;
+    draw_lod = voodoo->params.tLOD[0];
+    dl_lod   = tex_download_lod[i];
+    draw_fmt = voodoo->params.tformat[0];
+    dl_fmt   = tex_download_fmt[i];
+    if (((draw_lod ^ dl_lod) & 0x00700000) == 0 && draw_fmt == dl_fmt)
+        return 0;
+
+    voodoo->params.tLOD[0] &= ~0x00700fffu;
+    voodoo->params.tLOD[0] |= dl_lod & 0x00700fff;
+    voodoo->params.tformat[0] = dl_fmt;
+    voodoo->params.textureMode[0] &= ~(0xfu << 8);
+    voodoo->params.textureMode[0] |= (dl_fmt & 0xf) << 8;
+    voodoo_recalc_tex12(voodoo, 0);
+    return 1;
+}
