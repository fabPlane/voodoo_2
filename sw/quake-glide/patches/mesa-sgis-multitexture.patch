    /* Example of hooking in an extension function.
     * For DRI-based drivers, also see __driRegisterExtensions in the
@@ -1187,3 +1193,18 @@
 
 #endif  /* FX */
 
+
+
+/* GL_SGIS_multitexture entry points (looked up with dlsym by GLQuake):
+ * TEXTURE0_SGIS (0x835E) and up map onto the ARB units. */
+#define FX_TEXTURE0_SGIS 0x835E
+
+void GLAPIENTRY glSelectTextureSGIS(GLenum target)
+{
+   glActiveTextureARB(GL_TEXTURE0_ARB + (target - FX_TEXTURE0_SGIS));
+}
+
+void GLAPIENTRY glMTexCoord2fSGIS(GLenum target, GLfloat s, GLfloat t)
+{
+   glMultiTexCoord2fARB(GL_TEXTURE0_ARB + (target - FX_TEXTURE0_SGIS), s, t);
+}
