    if (!fxMesa->emulateTwoTMUs) 
       gl_extensions_disable(ctx, "GL_ARB_multitexture");
 
+   /* GLQuake (and other 1997 MiniGL titles) only know SGIS multitexture.
+    * Offer it with two real TMUs, so single-TMU boards keep the game's own
+    * two-pass path instead of Mesa's multipass emulation. */
