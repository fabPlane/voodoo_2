+
+/* Planar polygons (FX_PLANAR=1): a GL_POLYGON drawn with Glide's
+ * grDrawPlanarPolygonVertexList loads the parameter gradients once for the
+ * whole polygon (they are the same over a planar polygon) instead of once per
+ * fan triangle: ~16 register writes per extra triangle instead of ~34. Only
+ * polygons of 4+ vertices with one colour (flat, or all vertices equal), so
+ * Gouraud-shaded polygons keep their per-triangle colour planes. `cull`
+ * (clip/cull path): only when no triangle is clipped and all share one cull
+ * state. Returns 1 when the polygon was handled. */
+static int fxPlanarEnabled = -1;
+static int fxPlanarPoly(fxVertex *gWin, const GLubyte *cullmask, GLuint start, GLuint count, int smooth,
+                        GLubyte *flatColor)
+{
+   GrVertex v[64];
+   GLuint n = count - start, j, k, rot = 0;
+   if (fxPlanarEnabled < 0) fxPlanarEnabled = getenv("FX_PLANAR") != NULL;
+   if (!fxPlanarEnabled || n < 4 || n > 64) return 0;
+   if (cullmask) {
+      GLubyte f0 = cullmask[start+2];
+      for (j = start+2; j < count; j++) {
+         if (cullmask[j] & PRIM_ANY_CLIP) return 0;
+         if ((cullmask[j] & PRIM_NOT_CULLED) != (f0 & PRIM_NOT_CULLED)) return 0;
+      }
+      if (!(f0 & PRIM_NOT_CULLED)) return 1;   /* all culled */
+   }
+   if (smooth && !flatColor) {
+      const GLfloat *c0 = gWin[start].f;
+      for (j = start+1; j < count; j++) {
+         const GLfloat *c = gWin[j].f;
+         /* GrVertex: x y z r g b ooz a oow ... */
+         if (c[3] != c0[3] || c[4] != c0[4] || c[5] != c0[5] || c[7] != c0[7]) return 0;
+      }
+   }
+   /* Glide takes the gradients from the first fan triangle. Polygons with
+    * extra collinear vertices (T-junction fixes) can start with a sliver
+    * whose gradients are wildly off across the polygon (black patches on
+    * Quake II crates), so start the fan at the consecutive vertex triple of
+    * largest area, and give up when even that is tiny. */
+   {
+      GLuint best = 0;
+      GLfloat bestArea = 0.0f;
+      for (j = 0; j < n; j++) {
+         const GLfloat *a0 = gWin[start + j].f;
+         const GLfloat *a1 = gWin[start + (j + 1) % n].f;
+         const GLfloat *a2 = gWin[start + (j + 2) % n].f;
+         GLfloat ar = (a1[0] - a0[0]) * (a2[1] - a0[1]) - (a2[0] - a0[0]) * (a1[1] - a0[1]);
+         if (ar < 0) ar = -ar;
+         if (ar > bestArea) { bestArea = ar; best = j; }
+      }
+      if (bestArea < 8.0f) return 0;   /* 2x area: < 4 px^2 */
+      rot = best;
+   }
+   for (j = 0; j < n; j++) {
+      for (k = 0; k < 15; k++) ((GLfloat *)&v[j])[k] = gWin[start + (j + rot) % n].f[k];
+      if (flatColor) { /* GrVertex colours are 0..255 floats */
+         v[j].r = (GLfloat)flatColor[0]; v[j].g = (GLfloat)flatColor[1];
+         v[j].b = (GLfloat)flatColor[2]; v[j].a = (GLfloat)flatColor[3];
+      }
+   }
+   BEGIN_CLIP_LOOP();
+   grDrawPlanarPolygonVertexList(n, v);
+   END_CLIP_LOOP();
+   return 1;
+}
+
+/* ctx->Driver.PlanarPolygonFunc: Mesa's generic VB renderer (used with flat
+ * shading, render_index FX_FLAT) offers each unclipped GL_POLYGON here. */
+GLboolean fxDDPlanarPolygon(GLcontext *ctx, GLuint start, GLuint count, const GLubyte *cullmask)
+{
+   fxMesaContext fxMesa = (fxMesaContext)ctx->DriverCtx;
+   struct vertex_buffer *VB = ctx->VB;
+   int flat = (fxMesa->render_index & FX_FLAT) != 0;
+   if (fxMesa->render_index & ~FX_FLAT) return GL_FALSE; /* twoside, offset, fallback... */
+   return fxPlanarPoly(FX_DRIVER_DATA(VB)->verts, cullmask, start, count, 1,
+                       flat ? VB->Color[0]->data[start] : NULL) ? GL_TRUE : GL_FALSE;
+}
+
