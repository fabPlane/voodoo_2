+     * a negative T as an odd repeat bitwise-nots the coordinate. Quake's
+     * shell box side is T=-192..0, and that mirror pulls in the unused
+     * window rows of shot0sid under the label.
+     */
+    if (voodoo->type >= VOODOO_2 && (params->tLOD[tmu] & LOD_TMIRROR_S)) {
         if (state->tex_s & 0x1000)
             state->tex_s = ~state->tex_s;
     }
