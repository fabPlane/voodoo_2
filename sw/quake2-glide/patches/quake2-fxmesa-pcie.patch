diff -ruN '--exclude=.patched' Quake-2.orig/linux/vid_so.c Quake-2/linux/vid_so.c
--- a/linux/vid_so.c	2026-10-24 04:55:14.927897145 +0700
+++ b/linux/vid_so.c	2026-10-24 04:55:22.751483978 +0700
@@ -206,12 +206,12 @@
 	//regain root
 	seteuid(saved_euid);
 
-	if ((fp = fopen(SO_FILE, "r")) == NULL) {
-		Com_Printf( "LoadLibrary(\"%s\") failed: can't open " SO_FILE " (required for location of ref libraries)\n", name);
-		return false;
-	}
-	fgets(fn, sizeof(fn), fp);
-	fclose(fp);
+	// Ref libraries live next to the binary (Q2_REF_DIR overrides), not
+	// in a directory named by /etc/quake2.conf.
+	if (getenv("Q2_REF_DIR"))
+		strncpy(fn, getenv("Q2_REF_DIR"), sizeof(fn) - 1);
+	else if (!getcwd(fn, sizeof(fn)))
+		strcpy(fn, ".");
 	if (*fn && fn[strlen(fn) - 1] == '\n')
 		fn[strlen(fn) - 1] = 0;
 
@@ -224,7 +224,7 @@
 			Com_Printf( "LoadLibrary(\"%s\") failed: %s\n", name, strerror(errno));
 			return false;
 		}
-		if (st.st_uid != 0) {
+		if (0 && st.st_uid != 0) {
 			Com_Printf( "LoadLibrary(\"%s\") failed: ref is not owned by root\n", name);
 			return false;
 		}
