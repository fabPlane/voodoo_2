   }
+
+  // Regression: live GLQuake hang (consume queue full, rasterizer stuck
+  // "running"). With a bottom-up y origin each span sits at a lower address
+  // than the one before. Pixels killed at the end of span A (alpha test) leave
+  // its lanes unread; the next read is span B's first lane at a lower address.
+  // It must discard A's dead lanes and hit B in the cache, not take a direct
+  // miss that leaves A's lanes at the head forever.
+  test("reads skip dead lanes into a later span at a lower address") {
+    SimConfig.withIVerilog.compile(FramebufferPlaneReader(mkConfig)).doSim { dut =>
+      initDut(dut)
+      dut.io.mem.cmd.ready #= true
+      val cmds = scala.collection.mutable.ArrayBuffer[(Long, Int)]()
+      dut.clockDomain.onSamplings {
+        if (dut.io.mem.cmd.valid.toBoolean && dut.io.mem.cmd.ready.toBoolean)
+          cmds += ((dut.io.mem.cmd.fragment.address.toLong, dut.io.mem.cmd.fragment.source.toInt))
+      }
+      for ((start, end) <- Seq((0x100, 0x106), (0x000, 0x006))) {
+        dut.io.prefetchReq.valid #= true
+        dut.io.prefetchReq.startAddress #= start
+        dut.io.prefetchReq.endAddress #= end
+        dut.clockDomain.waitSamplingWhere(dut.io.prefetchReq.ready.toBoolean)
+      }
+      dut.io.prefetchReq.valid #= false
+      while (cmds.size < 2) dut.clockDomain.waitSampling()
+      // Span A (0x100..0x106) then span B (0x000..0x006), two beats each.
+      sendRspBeat(dut, 0x22221111L, last = false)
+      sendRspBeat(dut, 0x44443333L, last = true)
+      sendRspBeat(dut, 0x56781234L, last = false)
+      sendRspBeat(dut, 0xdef09abcL, last = true)
+      dut.io.mem.rsp.valid #= false
+      val issuedBefore = cmds.size
+
+      // Span A: only its first pixel survives; then span B in full.
+      for ((addr, expected) <- Seq(0x100 -> 0x1111L, 0x000 -> 0x1234L, 0x002 -> 0x5678L,
+          0x004 -> 0x9abcL, 0x006 -> 0xdef0L)) {
+        dut.io.readReq.valid #= true
+        dut.io.readReq.address #= addr
+        dut.clockDomain.waitSamplingWhere(dut.io.readReq.ready.toBoolean)
+        dut.io.readReq.valid #= false
+        while (!dut.io.readRsp.valid.toBoolean) dut.clockDomain.waitSampling()
+        assert(dut.io.readRsp.data.toLong == expected, f"0x$addr%x")
+        dut.clockDomain.waitSampling()
+      }
+      assert(cmds.size == issuedBefore, s"no direct misses expected, got ${cmds.drop(issuedBefore)}")
+      assert(!dut.io.busy.toBoolean, "all prefetched lanes should be consumed or discarded")
+    }
+  }
+  // Regression: GLQuake trace hang (status 0x0ffff3bf, SST/FBI/TMU busy forever).
+  // The colour and aux readers share one in-order framebuffer memory port. A
+  // reader that issues prefetch bursts whose lanes it cannot buffer leaves a
+  // response it will not accept at the head of that port. Draining it needs
+  // the pixel pipeline to consume lanes, which needs the other plane's read,
+  // which cannot be issued behind the blocked response: deadlock. Here the
+  // consumer stays idle while three 8-lane spans (24 lanes) are queued against a
+  // 17-lane buffer. Every burst the reader issues must be accepted in full;
+  // the third may only be issued once lanes have been consumed.
+  test("prefetch never issues a burst whose lanes cannot be buffered") {
+    SimConfig.withIVerilog.compile(FramebufferPlaneReader(mkConfig)).doSim { dut =>
+      initDut(dut)
+      assert(dut.lineBufferLanes == 17)
+
+      // In-order, one-burst-at-a-time memory: lane at byte address a holds a.
+      val bursts = scala.collection.mutable.Queue.empty[(Long, Int)] // (word address, beats)
+      var beat = 0
+      var stalled = 0
+      var maxStalled = 0
+      var issued = 0
+      dut.io.mem.cmd.ready #= true
+      dut.io.mem.rsp.fragment.source #= 0
+      fork {
+        while (true) {
+          dut.clockDomain.waitSampling()
+          if (dut.io.mem.rsp.valid.toBoolean) {
+            if (dut.io.mem.rsp.ready.toBoolean) {
+              stalled = 0
+              beat += 1
+              if (beat == bursts.head._2) {
+                bursts.dequeue()
+                beat = 0
+              }
+            } else {
+              stalled += 1
+              maxStalled = maxStalled max stalled
+            }
+          }
+          if (dut.io.mem.cmd.valid.toBoolean && dut.io.mem.cmd.ready.toBoolean) {
+            assert(dut.io.mem.cmd.fragment.source.toInt == 0, "unexpected direct miss")
+            bursts.enqueue(
