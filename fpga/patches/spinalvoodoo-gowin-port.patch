+  fill.unissued := fill.unissued + U(fill.allocate) - U(cmdFire)
+  when(slotDone) { fill.donePtr := fill.donePtr + 1 }
+  val validSet = Mux(fill.allocate, UIntToOh(fill.allocPtr, fillSlots), B(0, fillSlots bits))
+  val validClr = Mux(slotDone, UIntToOh(fill.donePtr, fillSlots), B(0, fillSlots bits))
+  fill.valid := (fill.valid & ~validClr) | validSet
+  fill.poisoned := (fill.poisoned & ~validSet) | Mux(io.invalidate, fill.valid, B(0, fillSlots bits))
+  when(io.invalidate) { lineValid := 0 }
+
+  // Register the assembled sample; the next sample's lookup overlaps its
+  // hand-off, so a hitting sample costs one cycle.
+  val assembled = Reg(Tmu.SampleFetch(c))
+  val outValid = RegInit(False)
+  out.ready := !outValid || io.sampleFetch.ready
+  when(io.sampleFetch.fire) { outValid := False }
+  when(out.fire) {
+    assembled.bilinear := s1.bilinear
+    assembled.passthrough := s1.passthrough
+    for (i <- 0 until lanes)
+      assembled.texels(i) := Mux(
+        s1.active(i),
+        texel16(if (paired) Mux(s1Have(i), s1Data(i), dataRd(i)) else dataRd(i),
+          s1.tapHalf(i), s1.tapByte(i), s1.is16Bit),
+        B(0, 16 bits)
+      )
+    outValid := True
+  }
+  io.sampleFetch.valid := outValid
+  io.sampleFetch.payload := assembled
+  io.busy := reqStream.valid || s1Valid || outValid || fill.valid.orR || hValid || hintQ.valid
+
+  private def counter(inc: UInt): UInt = {
+    val r = Reg(UInt(32 bits)) init (0)
+    r := r + inc.resized
+    r
+  }
+  // 0 word lookups (active lanes), 1 lookup-stage misses, 2 cycles the lookup
+  // stage waits on fills, 3 samples delivered.
+  io.perf(0) := counter(Mux(out.fire, Mux(s1.bilinear, U(4, 3 bits), U(1, 3 bits)), U(0, 3 bits)))
+  io.perf(1) := counter(backMiss.asUInt)
+  io.perf(2) := counter((s1Valid && (waitFill || reread || backMiss)).asUInt)
+  io.perf(3) := counter(io.sampleFetch.fire.asUInt)
+}
diff --git a/test/DitherArithTest.scala b/test/DitherArithTest.scala
new file mode 100644
index 0000000..98e6322
--- /dev/null
+++ b/test/DitherArithTest.scala
@@ -0,0 +1,77 @@
+//> using target.scope test
+
+package voodoo
+
+import org.scalatest.funsuite.AnyFunSuite
+import spinal.core._
+import spinal.core.sim._
+import voodoo.pixel.{Dither, DitherTables}
+
+/** The arithmetic dither and dither subtraction give exactly the 86Box table
+  * values they replaced: dither for every 8-bit value, position and matrix
+  * size; dither subtraction for every value a 565 expansion can produce.
+  */
+class DitherSubtractTop extends Component {
+  val io = new Bundle {
+    val v = in UInt (8 bits)
+    val x = in UInt (2 bits)
+    val y = in UInt (2 bits)
+    val use2x2 = in Bool ()
+    val rb = out UInt (8 bits)
+    val g = out UInt (8 bits)
+  }
+  io.rb := Dither.subtract(io.v, io.x, io.y, io.use2x2, green = false)
+  io.g := Dither.subtract(io.v, io.x, io.y, io.use2x2, green = true)
+}
+
+class DitherArithTest extends AnyFunSuite {
+  test("dither matches the 86Box tables for every value, position and matrix") {
+    SimConfig.withIVerilog.compile(Dither()).doSim { dut =>
+      dut.clockDomain.forkStimulus(10)
+      dut.io.output.ready #= true
+      dut.io.input.valid #= false
+      dut.clockDomain.waitSampling(2)
+      var errors = 0
+      for (use2x2 <- Seq(false, true); y <- 0 until 4; x <- 0 until 4; v <- 0 until 256) {
+        val p = dut.io.input.payload
+        p.r #= v; p.g #= v; p.b #= (255 - v); p.x #= x; p.y #= y
+        p.enable #= true; p.use2x2 #= use2x2
+        dut.io.input.valid #= true
+        dut.clockDomain.waitSamplingWhere(dut.io.input.ready.toBoolean)
+        dut.io.input.valid #= false
+        dut.clockDomain.waitSamplingWhere(dut.io.output.valid.toBoolean)
+        val (er, eg, eb) =
+          if (use2x2) (DitherTables.lookupRb2x2(v, y & 1, x & 1), DitherTables.lookupG2x2(v, y & 1, x & 1),
+            DitherTables.lookupRb2x2(255 - v, y & 1, x & 1))
+          else (DitherTables.lookupRb(v, y, x), DitherTables.lookupG(v, y, x), DitherTables.lookupRb(255 - v, y, x))
+        val o = dut.io.output.payload
+        if ((o.ditR.toInt, o.ditG.toInt, o.ditB.toInt) != (er, eg, eb)) {
+          if (errors < 5) println(s"v=$v x=$x y=$y 2x2=$use2x2: got ${(o.ditR.toInt, o.ditG.toInt, o.ditB.toInt)} want ${(er, eg, eb)}")
+          errors += 1
+        }
+      }
+      assert(errors == 0, s"$errors dither mismatches")
+    }
+  }
+
+  test("dither subtraction matches the 86Box tables for every 565-expanded value") {
+    SimConfig.withIVerilog.compile(new DitherSubtractTop).doSim { dut =>
+      val rbVals = (0 until 32).map(c => (c << 3) | (c >> 2))
+      val gVals = (0 until 64).map(c => (c << 2) | (c >> 4))
+      var errors = 0
+      for (use2x2 <- Seq(false, true); y <- 0 until 4; x <- 0 until 4; v <- (rbVals ++ gVals).distinct) {
+        dut.io.v #= v; dut.io.x #= x; dut.io.y #= y; dut.io.use2x2 #= use2x2
+        sleep(1)
+        if (rbVals.contains(v)) {
+          val want = if (use2x2) DitherTables.lookupDsubRb2x2(v, y & 1, x & 1) else DitherTables.lookupDsubRb(v, y, x)
+          if (dut.io.rb.toInt != want) { errors += 1; if (errors < 5) println(s"rb v=$v x=$x y=$y: ${dut.io.rb.toInt} want $want") }
+        }
+        if (gVals.contains(v)) {
+          val want = if (use2x2) DitherTables.lookupDsubG2x2(v, y & 1, x & 1) else DitherTables.lookupDsubG(v, y, x)
+          if (dut.io.g.toInt != want) { errors += 1; if (errors < 5) println(s"g v=$v x=$x y=$y: ${dut.io.g.toInt} want $want") }
+        }
+      }
+      assert(errors == 0, s"$errors dither-subtract mismatches")
+    }
+  }
+}
diff --git a/test/FramebufferAccessOrderTest.scala b/test/FramebufferAccessOrderTest.scala
new file mode 100644
index 0000000..9d9e1dc
--- /dev/null
+++ b/test/FramebufferAccessOrderTest.scala
@@ -0,0 +1,114 @@
+//> using target.scope test
+
+package voodoo
+
+import org.scalatest.funsuite.AnyFunSuite
+import spinal.core._
+import spinal.core.sim._
+import voodoo.pixel.FramebufferAccess
+
+import scala.collection.mutable
+
+/** Blended and opaque pixels interleaved, with colour reads answered after
+  * random delays: every blended pixel must get the destination colour read for
+  * it, and every opaque pixel its own colour. A no-read pixel's (zero) colour
+  * response once overtook an earlier pixel still waiting for its read, so
+  * every later blended pixel blended with its predecessor's destination
+  * (B113: GLQuake's screen scrambled once opaque passes stopped reading).
+  */
+class FramebufferAccessOrderTest extends AnyFunSuite {
+  private val config = Config.voodoo1()
+
+  private def expand565(d: Int): (Int, Int, Int) = {
+    val r5 = (d >> 11) & 0x1f; val g6 = (d >> 5) & 0x3f; val b5 = d & 0x1f
+    ((r5 << 3) | (r5 >> 2), (g6 << 2) | (g6 >> 4), (b5 << 3) | (b5 >> 2))
+  }
+
+  test("blended pixels get their own destination colour when mixed with opaque pixels") {
+    SimConfig.withIVerilog.compile(FramebufferAccess(config)).doSim(seed = 5) { dut =>
+      dut.clockDomain.forkStimulus(10)
+      val rnd = new scala.util.Random(9)
+      for (bt <- dut.io.input.payload.flatten) bt match {
+        case b: Bool => b #= false
+        case b: BitVector => b #= 0
+        case _ =>
+      }
+      dut.io.input.valid #= false
+      dut.io.output.ready #= true
+      dut.io.fbReadColorReq.ready #= false
+      dut.io.fbReadColorRsp.valid #= false
+      dut.io.fbReadAuxReq.ready #= true
+      dut.io.fbReadAuxRsp.valid #= false
+      dut.io.input.payload.routing.pixelStride #= 640
+      dut.clockDomain.waitSampling(5)
+
+      // Colour reads: accept requests, answer each with a distinct value after
+      // a random delay, in order.
+      var colorReqs = 0
+      val pendingRsp = mutable.Queue[(Long, Int)]() // ready-at cycle, data
+      var cycle = 0L
+      def dataFor(k: Int): Int = (k * 2654435761L >>> 7).toInt & 0xffff
+      fork {
+        while (true) {
+          dut.io.fbReadColorReq.ready #= rnd.nextInt(3) != 0
+          dut.clockDomain.waitSampling()
+          cycle += 1
+          if (dut.io.fbReadColorReq.valid.toBoolean && dut.io.fbReadColorReq.ready.toBoolean) {
+            pendingRsp.enqueue((cycle + 2 + rnd.nextInt(20), dataFor(colorReqs)))
+            colorReqs += 1
+          }
+        }
+      }
+      fork {
+        while (true) {
+          if (pendingRsp.nonEmpty && pendingRsp.head._1 <= cycle) {
+            dut.io.fbReadColorRsp.valid #= true
+            dut.io.fbReadColorRsp.payload.data #= pendingRsp.head._2
+            dut.clockDomain.waitSamplingWhere(dut.io.fbReadColorRsp.ready.toBoolean)
+            pendingRsp.dequeue()
+            dut.io.fbReadColorRsp.valid #= false
+          } else dut.clockDomain.waitSampling()
+        }
+      }
+
+      // Expected outputs, in order.
+      val expected = mutable.Queue[(Int, Int, Int)]()
+      var checked = 0
+      fork {
+        while (true) {
+          dut.clockDomain.waitSampling()
+          if (dut.io.output.valid.toBoolean && dut.io.output.ready.toBoolean) {
+            val e = expected.dequeue()
+            val c = dut.io.output.payload.color
+            val got = (c.r.toInt, c.g.toInt, c.b.toInt)
+            assert(got == e, s"pixel $checked: got $got expected $e")
+            checked += 1
+          }
+        }
+      }
+
+      val n = 400
+      var blendIdx = 0
+      for (i <- 0 until n) {
+        val blend = rnd.nextBoolean()
+        val p = dut.io.input.payload
+        p.coords(0) #= i % 64
+        p.coords(1) #= i / 64
+        p.alphaMode.alphaBlendEnable #= blend
+        p.alphaMode.rgbSrcFact #= 0 // zero
+        p.alphaMode.rgbDstFact #= 4 // one: output = destination colour
+        p.fbzMode.rgbBufferMask #= true
+        val (r, g, b) = (rnd.nextInt(256), rnd.nextInt(256), rnd.nextInt(256))
+        p.color.r #= r; p.color.g #= g; p.color.b #= b
+        if (blend) { expected.enqueue(expand565(dataFor(blendIdx))); blendIdx += 1 }
+        else expected.enqueue((r, g, b))
+        dut.io.input.valid #= true
+        dut.clockDomain.waitSamplingWhere(dut.io.input.ready.toBoolean)
+        dut.io.input.valid #= false
+        if (rnd.nextInt(4) == 0) dut.clockDomain.waitSampling(rnd.nextInt(5))
+      }
+      dut.clockDomain.waitSamplingWhere(checked == n || cycle > 200000)
+      assert(checked == n, s"only $checked of $n pixels came out")
+    }
+  }
+}
diff --git a/test/FramebufferPlaneBufferRandomTest.scala b/test/FramebufferPlaneBufferRandomTest.scala
new file mode 100644
index 0000000..b13b861
--- /dev/null
+++ b/test/FramebufferPlaneBufferRandomTest.scala
@@ -0,0 +1,85 @@
+//> using target.scope test
+
+package voodoo
+
+import org.scalatest.funsuite.AnyFunSuite
+import spinal.core._
+import spinal.core.sim._
+import spinal.lib.bus.bmb.sim._
+import voodoo.framebuffer.FramebufferPlaneBuffer
+
+/** Random span-like 16-bit pixel writes (runs, jumps, revisits, half-word
+  * masks) through the write buffer with memory stalls; after a flush every
+  * byte in memory must hold the last value written to it. Trace replay with
+  * the write buffer on lost whole triangles (Gowin --gowin CoreSim).
+  */
+class FramebufferPlaneBufferRandomTest extends AnyFunSuite {
+  private def run(lineWords: Int, seed: Int): Unit = {
+    val config = Config
+      .voodoo1()
+      .copy(
+        addressWidth = 14 bits,
+        fbWriteBufferLineWords = lineWords,
+        fbWriteBufferCount = 2,
+        useFbWriteBuffer = true,
+        useTexFillCache = false
+      )
+    SimConfig.withIVerilog.compile(FramebufferPlaneBuffer(config)).doSim(seed = seed) { dut =>
+      dut.clockDomain.forkStimulus(10)
+      dut.io.readReq.valid #= false
+      dut.io.readReq.address #= 0
+      dut.io.readRsp.ready #= true
+      dut.io.writeReq.valid #= false
+      dut.io.flush #= false
+      val size = 1 << 14
+      val memory = new BmbMemoryAgent(size)
+      memory.addPort(dut.io.mem, 0, dut.clockDomain, withDriver = true, withStall = true)
+      val model = Array.fill[Int](size)(0)
+      for (i <- 0 until size) memory.setByte(i, 0)
+      dut.clockDomain.waitSampling(2)
+
+      val rnd = new scala.util.Random(seed)
+      var pixel = 0 // 16-bit pixel index
+      for (n <- 0 until 6000) {
+        rnd.nextInt(20) match {
+          case 0 | 1 => pixel = rnd.nextInt(size / 2) // jump
+          case 2 => pixel = (pixel - rnd.nextInt(40)).max(0) // revisit just written
+          case _ => pixel += 1 // along the span
+        }
+        pixel %= size / 2
+        val byteAddr = pixel * 2
+        val word = byteAddr & ~3
+        val hi = (byteAddr & 2) != 0
+        val v = rnd.nextInt(0x10000)
+        val data = if (hi) v.toLong << 16 else v.toLong
+        val mask = if (hi) 0xc else 0x3
+        dut.io.writeReq.valid #= true
+        dut.io.writeReq.address #= word
+        dut.io.writeReq.data #= data
+        dut.io.writeReq.mask #= mask
+        dut.clockDomain.waitSamplingWhere(dut.io.writeReq.ready.toBoolean)
+        model(byteAddr) = v & 0xff
+        model(byteAddr + 1) = (v >> 8) & 0xff
+        if (rnd.nextInt(8) == 0) {
+          dut.io.writeReq.valid #= false
+          dut.clockDomain.waitSampling(rnd.nextInt(4))
+        }
+      }
+      dut.io.writeReq.valid #= false
+      dut.io.flush #= true
+      dut.clockDomain.waitSampling(4)
+      dut.clockDomain.waitSamplingWhere(!dut.io.busy.toBoolean)
+      dut.io.flush #= false
+      dut.clockDomain.waitSampling(50)
+      var bad = 0
+      for (i <- 0 until size if memory.getByte(i) != model(i).toByte) {
+        if (bad < 8) println(f"byte 0x$i%04x: mem ${memory.getByte(i) & 0xff}%02x want ${model(i)}%02x")
+        bad += 1
+      }
+      assert(bad == 0, s"$bad bytes wrong (lineWords $lineWords seed $seed)")
+    }
+  }
+
+  test("random pixel writes land, 4-word lines") { run(4, 1) }
+  test("random pixel writes land, 256-word lines") { run(256, 2) }
+}
