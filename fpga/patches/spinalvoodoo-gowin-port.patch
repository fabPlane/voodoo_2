diff --git a/src/voodoo/texture/TextureCombine.scala b/src/voodoo/texture/TextureCombine.scala
new file mode 100644
index 0000000..47fde4b
--- /dev/null
+++ b/src/voodoo/texture/TextureCombine.scala
@@ -0,0 +1,176 @@
+package voodoo.texture
+
+import voodoo._
+import spinal.core._
+
+/** TMU texture combine unit for two-TMU builds (textureMode bits 12-30).
+  *
+  * Bit-for-bit 86Box `voodoo_tmu_fetch_and_blend` (vid_voodoo_render.c), the
+  * trace reference, including its TMU1 behaviour: TMU1 combines only when
+  * tc/tca_sub_clocal is set (with "other" = 0, no invert), and takes its
+  * reverse-blend bits from TMU0's textureMode.
+  */
+object TextureCombine {
+
+  /** A TMU's filtered texel with the LOD it was fetched at. */
+  case class Texel() extends Bundle {
+    val r, g, b, a = UInt(8 bits)
+    val lod = UInt(4 bits)
+    val lodFrac = UInt(8 bits)
+  }
+
+  /** textureMode 30:12 (combine fields + trilinear) and tDetail 16:0. */
+  case class Mode() extends Bundle {
+    val bits = Bits(19 bits)
+    val tDetail = Bits(17 bits)
+    private def b(i: Int): Bool = bits(i - 12)
+    def tcZeroOther = b(12)
+    def tcSubClocal = b(13)
+    def tcMselect = bits(16 - 12 downto 14 - 12).asUInt
+    def tcReverseBlend = b(17)
+    def tcAddClocal = b(18)
+    def tcAddAlocal = b(19)
+    def tcInvertOutput = b(20)
+    def tcaZeroOther = b(21)
+    def tcaSubClocal = b(22)
+    def tcaMselect = bits(25 - 12 downto 23 - 12).asUInt
+    def tcaReverseBlend = b(26)
+    def tcaAddClocal = b(27)
+    def tcaAddAlocal = b(28)
+    def tcaInvertOutput = b(29)
+    def trilinear = b(30)
+    def detailMax = tDetail(7 downto 0).asUInt
+    def detailBias = tDetail(13 downto 8).asUInt
+    def detailScale = tDetail(16 downto 14).asUInt
+  }
+
+  private val W = 24 // signed working width (C ints; detail factors reach -1024)
+
+  private def s(v: UInt): SInt = v.resize(W - 1 bits).asSInt.resize(W bits)
+
+  private def clamp(v: SInt): UInt = {
+    val out = UInt(8 bits)
+    when(v < 0) { out := 0 }.elsewhen(v > 255) { out := 255 }.otherwise { out := v.asUInt.resize(8 bits) }
+    out
+  }
+
+  // (bias - lod) << scale, capped at max from above only (as 86Box).
+  private def detailFactor(m: Mode, lod: UInt): SInt = {
+    val f = ((s(m.detailBias) - s(lod)) << m.detailScale).resize(W bits)
+    Mux(f > s(m.detailMax), s(m.detailMax), f)
+  }
+
+  // x * (f + 1) >> 8, or x * ((f ^ 0xff) + 1) >> 8 when inverted (C ints).
+  // x is a texel difference (|x| <= 255) and f is at most 255 and at least
+  // the detail factor's -15 << 7, so (f ^ 0xff) + 1 is in [-2047, 256]: a
+  // 10 x 13-bit multiply gives the same product as the full width.
+  // Split in two pipeline stages: the operands (ops), then the multiply,
+  // add and clamp (finish); in one stage it missed 48 MHz (B156).
+  case class ChannelOps() extends Bundle {
+    val base = SInt(10 bits) // x
+    val f1 = SInt(13 bits) // (f or f ^ 0xff) + 1
+    val add = SInt(10 bits)
+  }
+
+  /** One TMU's combine, operands computed: finish() gives its texel. */
+  case class Ops() extends Bundle {
+    val c = Vec.fill(3)(ChannelOps())
+    val a = ChannelOps()
+    val enC, enA = Bool() // else the local texel's value
+    val invC, invA = Bool() // invert output
+    val local = Texel()
+  }
+
+  private def chanOps(x: SInt, f: SInt, inverted: Bool, add: SInt): ChannelOps = {
+    val o = ChannelOps()
+    o.base := x.resize(10 bits)
+    o.f1 := (Mux(inverted, f ^ S(0xff, W bits), f) + 1).resize(13 bits)
+    o.add := add.resize(10 bits)
+    o
+  }
+
+  private def finishChannel(o: ChannelOps): UInt =
+    clamp(((o.base * o.f1) >> 8).resize(W bits) + o.add.resize(W bits))
+
+  def finish(o: Ops): Texel = {
+    val out = Texel()
+    out.lod := o.local.lod
+    out.lodFrac := o.local.lodFrac
+    val localC = Seq(o.local.r, o.local.g, o.local.b)
+    for (k <- 0 until 3) {
+      val c = finishChannel(o.c(k))
+      Seq(out.r, out.g, out.b)(k) := Mux(o.enC, Mux(o.invC, c ^ U(0xff, 8 bits), c), localC(k))
+    }
+    val a = finishChannel(o.a)
+    out.a := Mux(o.enA, Mux(o.invA, a ^ U(0xff, 8 bits), a), o.local.a)
+    out
+  }
+
+  private def factorOf(sel: UInt, local: Texel, otherA: SInt, m: Mode, rgb: Int, alpha: Boolean): SInt = {
+    val f = SInt(W bits)
+    f := 0
+    val localC = Seq(local.r, local.g, local.b)(rgb)
+    switch(sel) {
+      is(1) { f := s(if (alpha) local.a else localC) } // c_local
+      is(2) { f := otherA } // a_other
+      is(3) { f := s(local.a) } // a_local
+      is(4) { f := detailFactor(m, local.lod) } // detail
+      is(5) { f := s(local.lodFrac) } // LOD fraction
+    }
+    f
+  }
+
+  /** TMU1's own combine (other = 0). */
+  def tmu1Ops(local: Texel, m1: Mode, m0: Mode): Ops = {
+    val o = Ops()
+    o.local := local
+    val trilinearOdd = m1.trilinear && local.lod(0)
+    val cReverse = Mux(trilinearOdd, m0.tcReverseBlend, !m0.tcReverseBlend)
+    val aReverse = Mux(trilinearOdd, m0.tcaReverseBlend, !m0.tcaReverseBlend)
+    val localC = Seq(local.r, local.g, local.b)
+    for (k <- 0 until 3) {
+      // 86Box: a_other is 0 for TMU1.
+      val f = factorOf(m1.tcMselect, local, S(0, W bits), m1, k, alpha = false)
+      val add = Mux(m1.tcAddClocal, s(localC(k)), Mux(m1.tcAddAlocal, s(local.a), S(0, W bits)))
+      o.c(k) := chanOps(-s(localC(k)), f, cReverse, add)
+    }
+    val fa = factorOf(m1.tcaMselect, local, S(0, W bits), m1, 0, alpha = true)
+    // 86Box inverts the alpha factor the other way round here.
+    val addA = Mux(m1.tcaAddClocal || m1.tcaAddAlocal, s(local.a), S(0, W bits))
+    o.a := chanOps(-s(local.a), fa, aReverse === False, addA)
+    o.enC := m1.tcSubClocal
+    o.enA := m1.tcaSubClocal
+    o.invC := False
+    o.invA := False
+    o
+  }
+
+  /** TMU0's combine with TMU1's (combined) output as "other". */
+  def tmu0Ops(local: Texel, other: Texel, m: Mode): Ops = {
+    val o = Ops()
+    o.local := local
+    val trilinearOdd = m.trilinear && local.lod(0)
+    val cReverse = Mux(trilinearOdd, m.tcReverseBlend, !m.tcReverseBlend)
+    val aReverse = Mux(trilinearOdd, m.tcaReverseBlend, !m.tcaReverseBlend)
+    val localC = Seq(local.r, local.g, local.b)
+    val otherC = Seq(other.r, other.g, other.b)
+    for (k <- 0 until 3) {
+      val base = Mux(m.tcZeroOther, S(0, W bits), s(otherC(k))) - Mux(m.tcSubClocal, s(localC(k)), S(0, W bits))
+      val f = factorOf(m.tcMselect, local, s(other.a), m, k, alpha = false)
+      val add = Mux(m.tcAddClocal, s(localC(k)), Mux(m.tcAddAlocal, s(local.a), S(0, W bits)))
+      o.c(k) := chanOps(base, f, cReverse, add)
+    }
+    val baseA = Mux(m.tcaZeroOther, S(0, W bits), s(other.a)) - Mux(m.tcaSubClocal, s(local.a), S(0, W bits))
+    val fa = factorOf(m.tcaMselect, local, s(other.a), m, 0, alpha = true)
+    val addA = Mux(m.tcaAddClocal || m.tcaAddAlocal, s(local.a), S(0, W bits))
+    o.a := chanOps(baseA, fa, aReverse, addA)
+    o.enC := True
+    o.enA := True
+    o.invC := m.tcInvertOutput
+    o.invA := m.tcaInvertOutput
+    o
+  }
+
+  def tmu1(local: Texel, m1: Mode, m0: Mode): Texel = finish(tmu1Ops(local, m1, m0))
+  def tmu0(local: Texel, other: Texel, m: Mode): Texel = finish(tmu0Ops(local, other, m))
+}
