+/* ------------------------------------------------------------------ */
+/* Frame window (SIM_TRACE_FRAMES=N:M)                                 */
+/* ------------------------------------------------------------------ */
+/* Records frames N .. N+M-1 (counted by swapbufferCMD writes) plus, from
+ * before them, everything that sets up state, in order: texture downloads
+ * and every register write except the per-triangle parameters (0x008-0x0FC,
+ * fixed and float) and the drawing commands (nop / fastfill / swap), which
+ * frame N redoes. Framebuffer accesses before the window are dropped (the
+ * replay starts with a cleared framebuffer). Full-run traces of a game are
+ * GBs; this keeps e.g. multitexture GLQuake frames with the right textures
+ * and modes. The program exits after the window. */
+static int tf_mode = -1;      /* -1 unset, 0 off, 1 before the window, 2 in it */
+static uint32_t tf_start, tf_count, tf_frames;
+
+static void tf_init(void)
+{
+    const char *e = getenv("SIM_TRACE_FRAMES");
+    tf_mode = 0;
+    if (!e || sscanf(e, "%u:%u", &tf_start, &tf_count) != 2 || tf_count == 0) return;
+    tf_mode = tf_start ? 1 : 2;
+    fprintf(stderr, "[sim_trace] frame window: frames %u..%u\n", tf_start, tf_start + tf_count - 1);
+}
+
+/* 1 = record this access. */
+static int tf_pass(uint32_t addr, uint32_t data, int is_write)
+{
+    (void)data;
+    if (tf_mode < 0) tf_init();
+    if (tf_mode == 0) return 1;
+    if (tf_mode == 1) {
+        uint32_t reg = addr & 0x3FCu;
+        if (!is_write || (addr >= 0x400000 && addr < 0x800000)) return 0; /* fb */
+        if (addr >= 0x800000) return 1;                                   /* texture */
+        if (reg == 0x128 && ++tf_frames == tf_start) {
+            tf_mode = 2;
+            tf_frames = 0;
+            /* swap marker at the window start: per-frame perf baselines */
+            trace_writer_record(&writer, VOODOO_TRACE_SWAP, swap_count, data);
+            fprintf(stderr, "[sim_trace] frame window starts (%lu entries of state)\n",
+                    (unsigned long)writer.entry_count);
+            return 0;
+        }
+        if (reg <= 0x0FC || reg == 0x120 || reg == 0x124 || reg == 0x128) return 0;
+        return 1;
+    }
+    if (tf_mode == 3) return 0;
+    if (is_write && addr < 0x400000 && (addr & 0x3FCu) == 0x128 && ++tf_frames >= tf_count) {
+        trace_writer_record(&writer, VOODOO_TRACE_SWAP, swap_count, data);
+        trace_writer_record(&writer, VOODOO_TRACE_WRITE_REG_L, addr, data);
+        tf_mode = 3;
+        fprintf(stderr, "[sim_trace] frame window done\n");
+        sim_shutdown();
+        exit(0);
+    }
+    return 1;
+}
