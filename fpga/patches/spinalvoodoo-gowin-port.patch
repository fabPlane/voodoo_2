+      vFrontPorch = 1,
+      vSync = 1,
+      vBackPorch = 1
+    )
+    val bufA = 0x1000L
+    val bufB = 0x2000L
+    def bufferOf(address: Long) = if (address >= bufB) bufB else bufA
+
+    SimConfig.withIVerilog
+      .compile(
