       dut.clockDomain.waitSampling()
 
+      // The read of 0x000 did not match the expected lane (0x004), so 0x004 and
+      // 0x006 were discarded as killed pixels; 0x004 now misses directly.
       dut.io.readReq.valid #= true
       dut.io.readReq.address #= 0x004
