+            cycle += 1
+            if (dut.io.readRsp.valid.toBoolean && dut.io.readRsp.ready.toBoolean) {
+              dut.io.readRsp.valid #= false
+            }
+            if (!dut.io.readRsp.valid.toBoolean && pending.nonEmpty) {
+              dut.io.readRsp.payload.data #= pending.dequeue()
+              dut.io.readRsp.valid #= true
+            }
+            if (dut.io.readReq.valid.toBoolean && dut.io.readReq.ready.toBoolean) {
+              val b = bufferOf(dut.io.readReq.payload.address.toLong)
+              pending.enqueue(0xffff)
+              if (b == drawing) violations += f"cycle $cycle: read from 0x$b%x while it is drawn"
+              if (drawing >= 0) readsAfterSwap(b) += 1
+            }
+            if (dut.io.prefetchReq.valid.toBoolean && dut.io.prefetchReq.ready.toBoolean) {
+              val b = bufferOf(dut.io.prefetchReq.payload.startAddress.toLong)
+              if (b == drawing) violations += f"cycle $cycle: prefetch from 0x$b%x while it is drawn"
+            }
+            // SwapBuffer: the swap completes on the retrace pulse; front/back
+            // follow the swap count from the next cycle.
+            if (swapPending && dut.io.status.frameDone.toBoolean) {
+              drawing = front
+              front = if (front == bufA) bufB else bufA
+              setBuffers()
+              swapPending = false
+              swaps += 1
+              nextSwapAt = cycle + 20 + (swaps * 37) % 90
+            }
+            if (!swapPending && cycle >= nextSwapAt) swapPending = true
+          }
+        }
+
+        dut.clockDomain.waitSampling(4)
+        dut.io.hdmiReset #= false
+        dut.clockDomain.waitSamplingWhere(swaps >= 12 || cycle > 40000)
+        dut.clockDomain.waitSampling(200)
+        assert(swaps >= 12, s"only $swaps swaps completed")
+        assert(violations.isEmpty, violations.take(5).mkString("; "))
+        assert(readsAfterSwap(bufA) > 0 && readsAfterSwap(bufB) > 0, "scanout stopped following swaps")
+        assert(!dut.io.underflow.toBoolean)
+      }
+  }
 }
diff --git a/test/PciFifoSwapOrderTest.scala b/test/PciFifoSwapOrderTest.scala
new file mode 100644
index 0000000..344fd75
--- /dev/null
+++ b/test/PciFifoSwapOrderTest.scala
@@ -0,0 +1,130 @@
+//> using target.scope test
+
+package voodoo
+
+import org.scalatest.funsuite.AnyFunSuite
+import spinal.core._
+import spinal.core.sim._
+import voodoo.bus.{PciFifo, RegisterCategory}
+
+/** A swapbufferCMD holds everything queued behind it until the swap has happened. Front/back
+  * follow the completed swap count, so a triangle drained while the swap still waits for retrace
+  * would draw into the finished frame that is about to be shown (GLQuake: blocks of the next
+  * frame on screen while moving).
+  */
+class PciFifoSwapOrderTest extends AnyFunSuite {
+  private val triangleCmdAddr = 0x100
+  private val swapCmdAddr = 0x128
+  private val swapWaitCycles = 300
+
+  private def mkDut() = {
+    val c = Config.voodoo1()
+    PciFifo(
+      busParams = RegisterBank.bmbParams(c),
+      categories = Map(
+        BigInt(triangleCmdAddr) -> RegisterCategory.fifoNoSync,
+        BigInt(swapCmdAddr) -> RegisterCategory.fifoWithSync
+      ),
+      floatAliases = Map.empty,
+      commandAddresses = Seq(BigInt(triangleCmdAddr), BigInt(swapCmdAddr))
+    )
+  }
+
+  private def run(withSwap: Boolean): Unit =
+    SimConfig.withIVerilog.compile(mkDut()).doSim { dut =>
+      dut.clockDomain.forkStimulus(10)
+      dut.io.cpuSide.cmd.valid #= false
+      dut.io.cpuSide.cmd.last #= true
+      dut.io.cpuSide.cmd.opcode #= 1
+      dut.io.cpuSide.cmd.address #= 0
+      dut.io.cpuSide.cmd.data #= 0
+      dut.io.cpuSide.cmd.mask #= 0xf
+      dut.io.cpuSide.cmd.length #= 3
+      dut.io.cpuSide.cmd.source #= 0
+      dut.io.cpuSide.rsp.ready #= true
+      dut.io.regSide.cmd.ready #= true
+      dut.io.regSide.rsp.valid #= false
+      dut.io.regSide.rsp.last #= true
+      dut.io.regSide.rsp.opcode #= 0
+      dut.io.regSide.rsp.data #= 0
+      dut.io.regSide.rsp.source #= 0
+      dut.io.texWrite.valid #= false
+      dut.io.texWrite.pciAddr #= 0
+      dut.io.texWrite.data #= 0
+      dut.io.texWrite.mask #= 0xf
+      dut.io.texDrain.ready #= true
+      dut.io.pipelineBusy #= false
+      dut.io.swapBusy #= false
+      dut.io.commandReady.foreach(_ #= true)
+      dut.io.wasEnqueuedAddr #= swapCmdAddr
+      dut.clockDomain.waitSampling(4)
+
+      // SwapBuffer model, as wired in Core: a swap write reaching the register bank at
+      // cycle T shows up as swapbufferCmd.valid at T+1 (command stream m2sPipe), then
+      // SwapBuffer waits for retrace; swapBusy covers both.
+      var cycle = 0L
+      var swapDrained = -1L
+      var swapDone = -1L
+      var busyLeft = 0
+      var startDelay = 0
+      val triDrains = scala.collection.mutable.ArrayBuffer.empty[Long]
+      fork {
+        while (true) {
+          dut.clockDomain.waitSampling()
+          cycle += 1
+          if (startDelay > 0) {
+            startDelay -= 1
+            if (startDelay == 0) busyLeft = swapWaitCycles
+          } else if (busyLeft > 0) {
+            busyLeft -= 1
+            if (busyLeft == 0) swapDone = cycle
+          }
+          if (dut.io.regSide.cmd.valid.toBoolean && dut.io.regSide.cmd.ready.toBoolean &&
+              dut.io.regSide.cmd.opcode.toInt == 1) {
+            dut.io.regSide.cmd.address.toInt match {
+              case `swapCmdAddr`     => swapDrained = cycle; startDelay = 1
+              case `triangleCmdAddr` => triDrains += cycle
+              case _                 =>
+            }
+          }
+          dut.io.swapBusy #= busyLeft > 0
+        }
+      }
+
+      def write(addr: Int, data: Long): Unit = {
+        dut.io.cpuSide.cmd.valid #= true
+        dut.io.cpuSide.cmd.address #= addr
+        dut.io.cpuSide.cmd.data #= data
+        dut.clockDomain.waitSamplingWhere(dut.io.cpuSide.cmd.ready.toBoolean)
+        dut.io.cpuSide.cmd.valid #= false
+      }
+
+      if (withSwap) write(swapCmdAddr, 1) // vsync enabled
+      // The next frame's triangles, back to back behind the swap.
+      val triCount = 4
+      for (_ <- 0 until triCount) write(triangleCmdAddr, 0)
+
+      dut.clockDomain.waitSamplingWhere(triDrains.size == triCount || cycle > 4 * swapWaitCycles)
+      assert(triDrains.size == triCount, s"only ${triDrains.size} of $triCount triangle commands drained")
+      if (withSwap) {
+        assert(swapDrained >= 0, "swap command never reached the register bank")
+        assert(swapDone >= 0, "swap never completed")
+        for (at <- triDrains)
+          assert(
+            at > swapDone,
+            s"triangle command drained at cycle $at while the swap drained at $swapDrained " +
+              s"was still pending (done at $swapDone)"
+          )
+      } else {
+        assert(triDrains.head < swapWaitCycles / 10, "triangle commands stalled without a swap")
+      }
+    }
+
+  test("triangle commands wait for the swap queued before them") {
+    run(withSwap = true)
+  }
+
+  test("triangle commands drain without a preceding swap") {
+    run(withSwap = false)
+  }
+}
diff --git a/test/PciFifoTextureOrderTest.scala b/test/PciFifoTextureOrderTest.scala
new file mode 100644
index 0000000..22d0579
--- /dev/null
+++ b/test/PciFifoTextureOrderTest.scala
@@ -0,0 +1,135 @@
+//> using target.scope test
+
+package voodoo
+
+import org.scalatest.funsuite.AnyFunSuite
+import spinal.core._
+import spinal.core.sim._
+import voodoo.bus.{PciFifo, RegisterCategory}
+
+/** Texture writes go through the PCI FIFO in order with register writes. A texture write queued
+  * behind a triangle command must not reach texture memory while that triangle may still sample
+  * the old texels (GLQuake draws a console glyph, then immediately re-uploads the glyph texture).
+  */
+class PciFifoTextureOrderTest extends AnyFunSuite {
+  private val triangleCmdAddr = 0x100
+  private val renderCycles = 200
+
+  private def mkDut() = {
+    val c = Config.voodoo1()
+    PciFifo(
+      busParams = RegisterBank.bmbParams(c),
+      categories = Map(
+        BigInt(triangleCmdAddr) -> RegisterCategory.fifoNoSync,
+        BigInt(0x104) -> RegisterCategory.fifoNoSync
+      ),
+      floatAliases = Map.empty,
+      commandAddresses = Seq(BigInt(triangleCmdAddr))
+    )
+  }
+
+  private def run(withTriangle: Boolean): Unit =
+    SimConfig.withIVerilog.compile(mkDut()).doSim { dut =>
+      dut.clockDomain.forkStimulus(10)
+      dut.io.cpuSide.cmd.valid #= false
+      dut.io.cpuSide.cmd.last #= true
+      dut.io.cpuSide.cmd.opcode #= 1
+      dut.io.cpuSide.cmd.address #= 0
+      dut.io.cpuSide.cmd.data #= 0
+      dut.io.cpuSide.cmd.mask #= 0xf
+      dut.io.cpuSide.cmd.length #= 3
+      dut.io.cpuSide.cmd.source #= 0
+      dut.io.cpuSide.rsp.ready #= true
+      dut.io.regSide.cmd.ready #= true
+      dut.io.regSide.rsp.valid #= false
+      dut.io.regSide.rsp.last #= true
+      dut.io.regSide.rsp.opcode #= 0
+      dut.io.regSide.rsp.data #= 0
+      dut.io.regSide.rsp.source #= 0
+      dut.io.texWrite.valid #= false
+      dut.io.texWrite.pciAddr #= 0
+      dut.io.texWrite.data #= 0
+      dut.io.texWrite.mask #= 0xf
+      dut.io.texDrain.ready #= true
+      dut.io.pipelineBusy #= false
+      dut.io.commandReady.foreach(_ #= true)
+      dut.io.wasEnqueuedAddr #= 0
+      dut.clockDomain.waitSampling(4)
+
+      // Pixel pipeline model: a triangle command reaching the register bank at cycle T
+      // makes the pipeline busy from T+1 (the regBank command stream is registered)
+      // for renderCycles cycles.
+      var cycle = 0L
+      var triangleDrained = -1L
+      var triangleDone = -1L
+      var busyLeft = 0
+      val texDrains = scala.collection.mutable.ArrayBuffer.empty[(Long, Long)] // (cycle, pciAddr)
+      fork {
+        while (true) {
+          dut.clockDomain.waitSampling()
+          cycle += 1
+          if (dut.io.texDrain.valid.toBoolean && dut.io.texDrain.ready.toBoolean) {
+            texDrains += ((cycle, dut.io.texDrain.pciAddr.toLong))
+          }
+          if (busyLeft > 0) {
+            busyLeft -= 1
+            if (busyLeft == 0) triangleDone = cycle
+          }
+          if (
+            dut.io.regSide.cmd.valid.toBoolean && dut.io.regSide.cmd.ready.toBoolean &&
+            dut.io.regSide.cmd.opcode.toInt == 1 &&
+            dut.io.regSide.cmd.address.toInt == triangleCmdAddr
+          ) {
+            triangleDrained = cycle
+            busyLeft = renderCycles
+          }
+          dut.io.pipelineBusy #= busyLeft > 0
+        }
+      }
+
+      if (withTriangle) {
+        dut.io.cpuSide.cmd.valid #= true
+        dut.io.cpuSide.cmd.address #= triangleCmdAddr
+        dut.io.cpuSide.cmd.data #= 0x42800000L
+        dut.clockDomain.waitSamplingWhere(dut.io.cpuSide.cmd.ready.toBoolean)
+        dut.io.cpuSide.cmd.valid #= false
+      }
+      // Back-to-back texture writes, as the host issues them right after the triangle.
+      val texCount = 8
+      for (i <- 0 until texCount) {
+        dut.io.texWrite.valid #= true
+        dut.io.texWrite.pciAddr #= 0x20000 + 4 * i
+        dut.io.texWrite.data #= i
+        dut.clockDomain.waitSamplingWhere(dut.io.texWrite.ready.toBoolean)
+      }
+      dut.io.texWrite.valid #= false
+
+      dut.clockDomain.waitSamplingWhere(
+        (texDrains.size == texCount && (!withTriangle || triangleDone >= 0)) ||
+          cycle > 10 * renderCycles
+      )
+      assert(texDrains.size == texCount, s"only ${texDrains.size} of $texCount texture writes drained")
+      assert(texDrains.map(_._2) == (0 until texCount).map(i => 0x20000L + 4 * i), "texture writes out of order")
+      if (withTriangle) {
+        assert(triangleDrained >= 0, "triangle command never reached the register bank")
+        assert(triangleDone >= 0, "triangle never finished")
+        for ((at, addr) <- texDrains) {
+          assert(
+            at > triangleDone,
+            f"texture write 0x$addr%x drained at cycle $at, while the triangle drained at " +
+              s"$triangleDrained was still drawing (done at $triangleDone)"
+          )
+        }
+      } else {
+        assert(texDrains.head._1 < renderCycles / 4, "texture writes stalled with an idle pipeline")
+      }
+    }
+
+  test("texture write waits for the triangle queued before it") {
+    run(withTriangle = true)
+  }
+
+  test("texture writes drain without a preceding triangle") {
+    run(withTriangle = false)
+  }
+}
