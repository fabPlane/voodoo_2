+  val doneTag = doneLine(aw - offBits - 1 downto idxBits)
+  val firstBeat = fill.beat === 0
+  val beatMask = Mux(firstBeat, fill.mask(fill.donePtr) | Mux(lineValid(doneIdx), B(0, lanes bits), B((1 << lanes) - 1, lanes bits)), fill.writeMask)
+  val fillDone = io.texRead.rsp.valid && io.texRead.rsp.last
+  // A fill is writing doneIdx in the lanes of beatMask from its first beat
+  // until its tags are written with the last one.
+  val fillWriting = Bool()
+  fillWriting := !firstBeat || io.texRead.rsp.valid
+  when(io.texRead.rsp.valid) {
+    val wAddr = (doneIdx ## fill.beat).asUInt
+    for (j <- 0 until lanes)
+      when(beatMask(j)) { dataMem(j).write(wAddr, io.texRead.rsp.fragment.data) }
+    when(firstBeat) { fill.writeMask := beatMask }
+    fill.beat := fill.beat + 1
+    when(io.texRead.rsp.last) {
+      for (j <- 0 until lanes) when(beatMask(j)) {
+        tagMem(j).write(doneIdx, doneTag)
+        hintTagMem(j).write(doneIdx, doneTag)
+      }
+      when(!fill.poisoned(fill.donePtr) && !io.invalidate) { lineValid(doneIdx) := True }
+      fill.beat := 0
+    }
+  }
+
+  // Lookup stage: tags and data are read as a sample enters s1, and read
+  // again (same sample) after each completed fill while it misses.
+  val s1Valid = RegInit(False)
+  val s1 = Reg(Lookup())
+  val s1Done = Bool()
+  val waitFill = RegInit(False)
+  val reread = RegInit(False)
+  val advance = !s1Valid || s1Done
+  reqStream.ready := advance
+  when(advance) {
+    s1Valid := reqStream.valid
+    s1 := reqLookup
+  }
+  val rdEnable = advance || reread
+  val tagRd = Vec(UInt(tagBits bits), lanes)
+  val dataRd = Vec(Bits(32 bits), lanes)
+  val rdConflict = Bits(lanes bits)
+  val laneHit = Bits(lanes bits)
+  for (i <- 0 until lanes) {
+    val rdAddr = Mux(reread, s1.addr(i), reqLookup.addr(i))
+    tagRd(i) := tagMem(i).readSync(lineIdx(rdAddr), enable = rdEnable)
+    dataRd(i) := dataMem(i).readSync((lineIdx(rdAddr) ## wordOff(rdAddr)).asUInt, enable = rdEnable)
+    // A read of a line being filled in this lane may see it half written.
+    rdConflict(i) := RegNextWhen(fillWriting && beatMask(i) && lineIdx(rdAddr) === doneIdx, rdEnable) init (False)
+    laneHit(i) := !s1.active(i) ||
+      (!rdConflict(i) && lineValid(lineIdx(s1.addr(i))) && tagRd(i) === lineTag(s1.addr(i)))
+  }
+  val allHit = laneHit.andR
+  val evaluate = s1Valid && !waitFill && !reread
+  val lookupHit = evaluate && allHit
+
+  val out = Stream(NoData)
+  out.valid := lookupHit
+  s1Done := out.fire
+
+  val missLane = OHToUInt(OHMasking.first(~laneHit))
+  val missLine = lineOf(s1.addr(missLane))
+  val backMiss = evaluate && !allHit
+  val backAlloc = backMiss && !fill.pending(missLine) && !fill.full
+  reread := False
+  when(backMiss) {
+    when(fillDone) { reread := True } otherwise { waitFill := True }
+  }
+  when(waitFill && fillDone) {
+    waitFill := False
+    reread := True
+  }
+  when(backAlloc) {
+    fill.allocate := True
+    fill.allocLine := missLine
+    fill.allocMask := laneWriteFor(missLine, s1.addr, s1.active)
+  }
+
+  // Hints: requests entering the request FIFO (dropped when the hint queue is
+  // full), looked up against hintTagMem; each missing line not already
+  // pending is queued as a fill when no lookup-stage fill is.
+  val hintIn = Stream(Hint())
+  hintIn.valid := io.sampleRequest.fire
+  val inTaps = tapAddrsOf(io.sampleRequest.payload)
+  for (i <- 0 until lanes) hintIn.payload.addr(i) := wordAddr(inTaps(i))
+  hintIn.payload.active := Mux(io.sampleRequest.payload.bilinear, B"1111", B"0001")
+  val hintQ = hintIn.toFlow.toStream.queue(2)
+  val hValid = RegInit(False)
+  val hFresh = RegInit(False) // tags read last cycle belong to h
+  val h = Reg(Hint())
+  val hTodo = Reg(Bits(lanes bits))
+  hFresh := False
+  val hTagRd = Vec(UInt(tagBits bits), lanes)
+  for (i <- 0 until lanes)
+    hTagRd(i) := hintTagMem(i).readSync(lineIdx(hintQ.payload.addr(i)), enable = hintQ.fire)
+  val hTagKeep = Vec(Reg(UInt(tagBits bits)), lanes)
+  val hTag = Vec((0 until lanes).map(i => Mux(hFresh, hTagRd(i), hTagKeep(i))))
+  when(hFresh) { hTagKeep := hTagRd }
+  val hNeed = Bits(lanes bits)
+  for (i <- 0 until lanes) {
+    val present = lineValid(lineIdx(h.addr(i))) && hTag(i) === lineTag(h.addr(i))
+    hNeed(i) := hTodo(i) && !present && !fill.pending(lineOf(h.addr(i)))
+  }
+  val hLane = OHToUInt(OHMasking.first(hNeed))
+  val hLine = lineOf(h.addr(hLane))
+  val hAlloc = hValid && hNeed.orR && !backAlloc && !fill.full
+  when(hAlloc) {
+    fill.allocate := True
+    fill.allocLine := hLine
+    fill.allocMask := laneWriteFor(hLine, h.addr, h.active)
+  }
+  val hDoneLanes = Bits(lanes bits)
+  for (i <- 0 until lanes) hDoneLanes(i) := !hNeed(i) || (hAlloc && lineOf(h.addr(i)) === hLine)
+  val hFinished = !hValid || hDoneLanes.andR
+  when(hValid) { hTodo := hTodo & ~hDoneLanes }
+  hintQ.ready := hFinished
+  when(hFinished) { hValid := hintQ.valid }
+  when(hintQ.fire) {
+    h := hintQ.payload
+    hTodo := hintQ.payload.active
+    hFresh := True
+  }
+
+  // Slot bookkeeping.
+  val slotDone = fillDone
+  when(fill.allocate) {
+    fill.line(fill.allocPtr) := fill.allocLine
+    fill.mask(fill.allocPtr) := fill.allocMask
+    fill.allocPtr := fill.allocPtr + 1
+  }
+  val cmdFire = io.texRead.cmd.fire
+  when(cmdFire) { fill.cmdPtr := fill.cmdPtr + 1 }
+  fill.unissued := fill.unissued + U(fill.allocate) - U(cmdFire)
+  when(slotDone) { fill.donePtr := fill.donePtr + 1 }
+  val validSet = Mux(fill.allocate, UIntToOh(fill.allocPtr, fillSlots), B(0, fillSlots bits))
+  val validClr = Mux(slotDone, UIntToOh(fill.donePtr, fillSlots), B(0, fillSlots bits))
+  fill.valid := (fill.valid & ~validClr) | validSet
+  fill.poisoned := (fill.poisoned & ~validSet) | Mux(io.invalidate, fill.valid, B(0, fillSlots bits))
+  when(io.invalidate) { lineValid := 0 }
+
+  // Register the assembled sample; the next sample's lookup overlaps its
+  // hand-off, so a hitting sample costs one cycle.
+  val assembled = Reg(Tmu.SampleFetch(c))
+  val outValid = RegInit(False)
+  out.ready := !outValid || io.sampleFetch.ready
+  when(io.sampleFetch.fire) { outValid := False }
+  when(out.fire) {
+    assembled.bilinear := s1.bilinear
+    assembled.passthrough := s1.passthrough
+    for (i <- 0 until lanes)
+      assembled.texels(i) := Mux(
+        s1.active(i),
+        texel16(dataRd(i), s1.tapHalf(i), s1.tapByte(i), s1.is16Bit),
+        B(0, 16 bits)
+      )
+    outValid := True
+  }
+  io.sampleFetch.valid := outValid
+  io.sampleFetch.payload := assembled
+  io.busy := reqStream.valid || s1Valid || outValid || fill.valid.orR || hValid || hintQ.valid
+
+  private def counter(inc: UInt): UInt = {
+    val r = Reg(UInt(32 bits)) init (0)
+    r := r + inc.resized
+    r
+  }
+  // 0 word lookups (active lanes), 1 lookup-stage misses, 2 cycles the lookup
+  // stage waits on fills, 3 samples delivered.
+  io.perf(0) := counter(Mux(out.fire, Mux(s1.bilinear, U(4, 3 bits), U(1, 3 bits)), U(0, 3 bits)))
+  io.perf(1) := counter(backMiss.asUInt)
+  io.perf(2) := counter((s1Valid && (waitFill || reread || backMiss)).asUInt)
+  io.perf(3) := counter(io.sampleFetch.fire.asUInt)
+}
diff --git a/test/FramebufferAccessOrderTest.scala b/test/FramebufferAccessOrderTest.scala
new file mode 100644
index 0000000..9d9e1dc
--- /dev/null
+++ b/test/FramebufferAccessOrderTest.scala
@@ -0,0 +1,114 @@
+//> using target.scope test
+
+package voodoo
+
+import org.scalatest.funsuite.AnyFunSuite
+import spinal.core._
+import spinal.core.sim._
+import voodoo.pixel.FramebufferAccess
+
+import scala.collection.mutable
+
+/** Blended and opaque pixels interleaved, with colour reads answered after
+  * random delays: every blended pixel must get the destination colour read for
+  * it, and every opaque pixel its own colour. A no-read pixel's (zero) colour
+  * response once overtook an earlier pixel still waiting for its read, so
+  * every later blended pixel blended with its predecessor's destination
+  * (B113: GLQuake's screen scrambled once opaque passes stopped reading).
+  */
+class FramebufferAccessOrderTest extends AnyFunSuite {
+  private val config = Config.voodoo1()
+
+  private def expand565(d: Int): (Int, Int, Int) = {
+    val r5 = (d >> 11) & 0x1f; val g6 = (d >> 5) & 0x3f; val b5 = d & 0x1f
+    ((r5 << 3) | (r5 >> 2), (g6 << 2) | (g6 >> 4), (b5 << 3) | (b5 >> 2))
+  }
+
+  test("blended pixels get their own destination colour when mixed with opaque pixels") {
+    SimConfig.withIVerilog.compile(FramebufferAccess(config)).doSim(seed = 5) { dut =>
+      dut.clockDomain.forkStimulus(10)
+      val rnd = new scala.util.Random(9)
+      for (bt <- dut.io.input.payload.flatten) bt match {
+        case b: Bool => b #= false
+        case b: BitVector => b #= 0
+        case _ =>
+      }
+      dut.io.input.valid #= false
+      dut.io.output.ready #= true
+      dut.io.fbReadColorReq.ready #= false
+      dut.io.fbReadColorRsp.valid #= false
+      dut.io.fbReadAuxReq.ready #= true
+      dut.io.fbReadAuxRsp.valid #= false
+      dut.io.input.payload.routing.pixelStride #= 640
+      dut.clockDomain.waitSampling(5)
+
+      // Colour reads: accept requests, answer each with a distinct value after
+      // a random delay, in order.
+      var colorReqs = 0
+      val pendingRsp = mutable.Queue[(Long, Int)]() // ready-at cycle, data
+      var cycle = 0L
+      def dataFor(k: Int): Int = (k * 2654435761L >>> 7).toInt & 0xffff
+      fork {
+        while (true) {
+          dut.io.fbReadColorReq.ready #= rnd.nextInt(3) != 0
+          dut.clockDomain.waitSampling()
+          cycle += 1
+          if (dut.io.fbReadColorReq.valid.toBoolean && dut.io.fbReadColorReq.ready.toBoolean) {
+            pendingRsp.enqueue((cycle + 2 + rnd.nextInt(20), dataFor(colorReqs)))
+            colorReqs += 1
+          }
+        }
+      }
+      fork {
+        while (true) {
+          if (pendingRsp.nonEmpty && pendingRsp.head._1 <= cycle) {
+            dut.io.fbReadColorRsp.valid #= true
+            dut.io.fbReadColorRsp.payload.data #= pendingRsp.head._2
+            dut.clockDomain.waitSamplingWhere(dut.io.fbReadColorRsp.ready.toBoolean)
+            pendingRsp.dequeue()
+            dut.io.fbReadColorRsp.valid #= false
+          } else dut.clockDomain.waitSampling()
+        }
+      }
+
+      // Expected outputs, in order.
+      val expected = mutable.Queue[(Int, Int, Int)]()
+      var checked = 0
+      fork {
+        while (true) {
+          dut.clockDomain.waitSampling()
+          if (dut.io.output.valid.toBoolean && dut.io.output.ready.toBoolean) {
+            val e = expected.dequeue()
+            val c = dut.io.output.payload.color
+            val got = (c.r.toInt, c.g.toInt, c.b.toInt)
+            assert(got == e, s"pixel $checked: got $got expected $e")
+            checked += 1
+          }
+        }
+      }
+
+      val n = 400
+      var blendIdx = 0
+      for (i <- 0 until n) {
+        val blend = rnd.nextBoolean()
+        val p = dut.io.input.payload
+        p.coords(0) #= i % 64
+        p.coords(1) #= i / 64
+        p.alphaMode.alphaBlendEnable #= blend
+        p.alphaMode.rgbSrcFact #= 0 // zero
+        p.alphaMode.rgbDstFact #= 4 // one: output = destination colour
+        p.fbzMode.rgbBufferMask #= true
+        val (r, g, b) = (rnd.nextInt(256), rnd.nextInt(256), rnd.nextInt(256))
+        p.color.r #= r; p.color.g #= g; p.color.b #= b
+        if (blend) { expected.enqueue(expand565(dataFor(blendIdx))); blendIdx += 1 }
+        else expected.enqueue((r, g, b))
+        dut.io.input.valid #= true
+        dut.clockDomain.waitSamplingWhere(dut.io.input.ready.toBoolean)
+        dut.io.input.valid #= false
+        if (rnd.nextInt(4) == 0) dut.clockDomain.waitSampling(rnd.nextInt(5))
+      }
+      dut.clockDomain.waitSamplingWhere(checked == n || cycle > 200000)
+      assert(checked == n, s"only $checked of $n pixels came out")
+    }
+  }
+}
