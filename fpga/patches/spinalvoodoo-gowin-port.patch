@@ -0,0 +1,99 @@
+package voodoo
+
+import spinal.core._
+import spinal.lib._
+import spinal.lib.bus.bmb._
+
+/** Simulation memory with one independent, pipelined BMB port per client,
+  * like a board where every client has its own AXI path into a mostly idle
+  * DRAM controller (the Tang Mega 138K dock): each port takes a command every
+  * cycle, answers in command order `readLatency` cycles after a read command
+  * (one word per cycle after that) and `writeLatency` cycles after a write
+  * burst's last beat. SimBmbMemory serves one transaction at a time on one
+  * shared bus, so with DRAM-like latency it makes every client wait on every
+  * other's round trip.
+  *
+  * The byte-lane arrays keep SimBmbMemory's names (ram_symbol0..3) so the C++
+  * harness can load and read memory the same way. Writes land when the beat
+  * is accepted (burst start address + beat index) and reads sample memory as
+  * each word is returned.
+  */
+case class SimBmbMultiPortMemory(
+    ports: Seq[BmbParameter],
+    size: Int,
+    readLatency: Int,
