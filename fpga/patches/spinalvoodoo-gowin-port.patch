diff --git a/emu/glide/glide2x/sst1/glide/tests/mtex00.c b/emu/glide/glide2x/sst1/glide/tests/mtex00.c
new file mode 100644
index 0000000..fc67cfb
--- /dev/null
+++ b/emu/glide/glide2x/sst1/glide/tests/mtex00.c
@@ -0,0 +1,212 @@
+/*
+ * mtex00 - two-TMU texture combine (Voodoo 1 boards with two TREX, and the
+ * Voodoo 2 multitexture path).
+ *
+ * TMU1 holds a "lightmap", TMU0 a base texture; each quad combines them
+ * differently in TMU0's texture combine unit: multiply (GLQuake's
+ * single-pass lightmapping), add, blend by TMU0 alpha, and TMU1 passed
+ * through. The fifth quad multiplies with perspective (different W per
+ * vertex) and different texture coordinates per TMU.
+ *
+ * Procedural textures, so no .3df files. With the trace runtime, run with
+ * SST_TMUCFG=0x40 (TMU1 present) and SST_TMUMEM_SIZE=2.
+ */
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <assert.h>
+#include <string.h>
+
+#include <glide.h>
+#include "tlib.h"
+
+GrHwConfiguration hwconfig;
+static char version[80];
+
+static const char name[]    = "mtex00";
+static const char purpose[] = "two-TMU texture combine";
+static const char usage[]   = "-n <frames>";
+
+static FxU16 base565[64 * 64];
+static FxU16 light4444[32 * 32];
+/* Quad 6: 8-bit paletted textures, each TMU with its own palette. */
+static FxU8 base8[64 * 64];
+static FxU8 light8[32 * 32];
+static GuTexPalette palBase, palLight;
+
+static void makeTextures(void)
+{
+  int x, y;
+  for (y = 0; y < 64; y++)
+    for (x = 0; x < 64; x++) {
+      int c = ((x >> 3) ^ (y >> 3)) & 1;
+      FxU16 r = c ? 31 : (FxU16)(x >> 1);
+      FxU16 g = c ? (FxU16)(y) : 63;
+      FxU16 b = c ? 8 : (FxU16)((x + y) >> 2);
+      base565[y * 64 + x] = (FxU16)((r << 11) | (g << 5) | b);
+    }
+  /* ARGB4444 so TMU1 also has an alpha channel */
+  for (y = 0; y < 32; y++)
+    for (x = 0; x < 32; x++) {
+      int dx = x - 16, dy = y - 16;
+      int d = 15 - ((dx * dx + dy * dy) >> 4);
+      FxU16 l = (FxU16)(d < 2 ? 2 : d);
+      FxU16 a = (FxU16)((x >> 1) & 15);
+      light4444[y * 32 + x] = (FxU16)((a << 12) | (l << 8) | (l << 4) | ((l * 3) >> 2));
+    }
+  for (y = 0; y < 64; y++)
+    for (x = 0; x < 64; x++)
+      base8[y * 64 + x] = (FxU8)(((x >> 2) + (y >> 2) * 16) & 0xff);
+  for (y = 0; y < 32; y++)
+    for (x = 0; x < 32; x++)
+      light8[y * 32 + x] = (FxU8)((x * 8) & 0xff);
+  for (x = 0; x < 256; x++) {
+    /* distinct palettes: a red/green ramp for TMU0, a blue/grey one for TMU1 */
+    palBase.data[x] = 0xff000000u | ((FxU32)x << 16) | ((FxU32)(255 - x) << 8) | 0x20;
+    palLight.data[x] = 0xff000000u | ((FxU32)(x / 2 + 64) << 16) | ((FxU32)(x / 2 + 64) << 8) | (FxU32)(255 - x / 2);
+  }
+}
+
+static void quad(float x0, float y0, float x1, float y1, float w0, float w1, float tmu1Scale)
+{
+  GrVertex v[4];
+  int i;
+  memset(v, 0, sizeof(v));
+  v[0].x = x0; v[0].y = y0;
+  v[1].x = x1; v[1].y = y0;
+  v[2].x = x1; v[2].y = y1;
+  v[3].x = x0; v[3].y = y1;
+  for (i = 0; i < 4; i++) {
+    float u = (i == 1 || i == 2) ? 1.0f : 0.0f;
+    float t = (i >= 2) ? 1.0f : 0.0f;
+    float w = (i == 0 || i == 3) ? w0 : w1;
+    float oow = 1.0f / w;
+    v[i].oow = oow;
+    v[i].r = 255.0f; v[i].g = 255.0f; v[i].b = 255.0f; v[i].a = 255.0f;
+    v[i].tmuvtx[0].sow = u * 255.0f * oow;
+    v[i].tmuvtx[0].tow = t * 255.0f * oow;
+    v[i].tmuvtx[0].oow = oow;
+    v[i].tmuvtx[1].sow = (0.1f + u * tmu1Scale) * 255.0f * oow;
+    v[i].tmuvtx[1].tow = (0.05f + t * tmu1Scale) * 255.0f * oow;
+    v[i].tmuvtx[1].oow = oow;
+  }
+  grDrawTriangle(&v[0], &v[1], &v[2]);
+  grDrawTriangle(&v[0], &v[2], &v[3]);
+}
+
+int
+main(int argc, char **argv)
+{
+  char match;
+  char **remArgs;
+  int  rv;
+  int  frames = -1;
+  GrTexInfo base, light, base8i, light8i;
+  FxU32 baseAddr, lightAddr, base8Addr, light8Addr;
+  float scrWidth = 640.0f, scrHeight = 480.0f;
+
+  while ((rv = tlGetOpt(argc, argv, "n", &match, &remArgs)) != 0) {
+    if (rv == -1) {
+      printf("%s %s\n", name, usage);
+      return -1;
+    }
+    if (match == 'n') frames = atoi(remArgs[0]);
+  }
+  if (frames == -1) frames = 1;
+
+  tlSetScreen(scrWidth, scrHeight);
+  grGlideGetVersion(version);
+  printf("%s:\n%s\n%s\n", name, purpose, version);
+
+  grGlideInit();
+  assert(grSstQueryHardware(&hwconfig));
+  printf("TMUs: %d\n", hwconfig.SSTs[0].sstBoard.VoodooConfig.nTexelfx);
+  if (hwconfig.SSTs[0].sstBoard.VoodooConfig.nTexelfx < 2) {
+    printf("needs two TMUs (trace runtime: SST_TMUCFG=0x40)\n");
+    return 1;
+  }
+  grSstSelect(0);
+  assert(grSstWinOpen(0, GR_RESOLUTION_640x480, GR_REFRESH_60Hz,
+                      GR_COLORFORMAT_ABGR, GR_ORIGIN_UPPER_LEFT, 2, 1));
+
+  makeTextures();
+  base.smallLod = base.largeLod = GR_LOD_64;
+  base.aspectRatio = GR_ASPECT_1x1;
+  base.format = GR_TEXFMT_RGB_565;
+  base.data = base565;
+  light.smallLod = light.largeLod = GR_LOD_32;
+  light.aspectRatio = GR_ASPECT_1x1;
+  light.format = GR_TEXFMT_ARGB_4444;
+  light.data = light4444;
+
+  baseAddr = grTexMinAddress(GR_TMU0);
+  lightAddr = grTexMinAddress(GR_TMU1);
+  grTexDownloadMipMap(GR_TMU0, baseAddr, GR_MIPMAPLEVELMASK_BOTH, &base);
+  grTexDownloadMipMap(GR_TMU1, lightAddr, GR_MIPMAPLEVELMASK_BOTH, &light);
+  base8i = base; base8i.format = GR_TEXFMT_P_8; base8i.data = base8;
+  light8i = light; light8i.format = GR_TEXFMT_P_8; light8i.data = light8;
+  base8Addr = baseAddr + grTexTextureMemRequired(GR_MIPMAPLEVELMASK_BOTH, &base);
+  light8Addr = lightAddr + grTexTextureMemRequired(GR_MIPMAPLEVELMASK_BOTH, &light);
+  grTexDownloadMipMap(GR_TMU0, base8Addr, GR_MIPMAPLEVELMASK_BOTH, &base8i);
+  grTexDownloadMipMap(GR_TMU1, light8Addr, GR_MIPMAPLEVELMASK_BOTH, &light8i);
+  grTexSource(GR_TMU0, baseAddr, GR_MIPMAPLEVELMASK_BOTH, &base);
+  grTexSource(GR_TMU1, lightAddr, GR_MIPMAPLEVELMASK_BOTH, &light);
+  grTexFilterMode(GR_TMU0, GR_TEXTUREFILTER_BILINEAR, GR_TEXTUREFILTER_BILINEAR);
+  grTexFilterMode(GR_TMU1, GR_TEXTUREFILTER_BILINEAR, GR_TEXTUREFILTER_BILINEAR);
+  grTexClampMode(GR_TMU0, GR_TEXTURECLAMP_WRAP, GR_TEXTURECLAMP_WRAP);
+  grTexClampMode(GR_TMU1, GR_TEXTURECLAMP_CLAMP, GR_TEXTURECLAMP_CLAMP);
+  grTexMipMapMode(GR_TMU0, GR_MIPMAP_DISABLE, FXFALSE);
+  grTexMipMapMode(GR_TMU1, GR_MIPMAP_DISABLE, FXFALSE);
+
+  /* Per-TMU texture coordinates. */
+  grHints(GR_HINT_STWHINT, GR_STWHINT_ST_DIFF_TMU1);
+
+  /* The FBI takes TMU0's output. */
+  grColorCombine(GR_COMBINE_FUNCTION_SCALE_OTHER, GR_COMBINE_FACTOR_ONE,
+                 GR_COMBINE_LOCAL_ITERATED, GR_COMBINE_OTHER_TEXTURE, FXFALSE);
+  grAlphaCombine(GR_COMBINE_FUNCTION_SCALE_OTHER, GR_COMBINE_FACTOR_ONE,
+                 GR_COMBINE_LOCAL_ITERATED, GR_COMBINE_OTHER_TEXTURE, FXFALSE);
+  /* TMU1: its texel. */
+  grTexCombine(GR_TMU1, GR_COMBINE_FUNCTION_LOCAL, GR_COMBINE_FACTOR_NONE,
+               GR_COMBINE_FUNCTION_LOCAL, GR_COMBINE_FACTOR_NONE, FXFALSE, FXFALSE);
+
+  while (frames--) {
+    grBufferClear(0x303030, 0, GR_WDEPTHVALUE_FARTHEST);
+
+    /* 1: multiply (lightmap) */
+    grTexCombine(GR_TMU0, GR_COMBINE_FUNCTION_SCALE_OTHER, GR_COMBINE_FACTOR_LOCAL,
+                 GR_COMBINE_FUNCTION_SCALE_OTHER, GR_COMBINE_FACTOR_LOCAL_ALPHA, FXFALSE, FXFALSE);
+    quad(20, 20, 200, 200, 1.0f, 1.0f, 1.0f);
+    /* 2: add */
+    grTexCombine(GR_TMU0, GR_COMBINE_FUNCTION_SCALE_OTHER_ADD_LOCAL, GR_COMBINE_FACTOR_ONE,
+                 GR_COMBINE_FUNCTION_LOCAL, GR_COMBINE_FACTOR_NONE, FXFALSE, FXFALSE);
+    quad(230, 20, 410, 200, 1.0f, 1.0f, 1.0f);
+    /* 3: blend other/local by TMU0 alpha (1 for RGB565), inverted factor */
+    grTexCombine(GR_TMU0, GR_COMBINE_FUNCTION_BLEND, GR_COMBINE_FACTOR_ONE_MINUS_LOCAL_ALPHA,
+                 GR_COMBINE_FUNCTION_BLEND_OTHER, GR_COMBINE_FACTOR_OTHER_ALPHA, FXFALSE, FXTRUE);
+    quad(440, 20, 620, 200, 1.0f, 1.0f, 1.0f);
+    /* 4: TMU1 passed through TMU0 */
+    grTexCombine(GR_TMU0, GR_COMBINE_FUNCTION_SCALE_OTHER, GR_COMBINE_FACTOR_ONE,
+                 GR_COMBINE_FUNCTION_SCALE_OTHER, GR_COMBINE_FACTOR_ONE, FXFALSE, FXFALSE);
+    quad(20, 240, 200, 420, 1.0f, 1.0f, 2.0f);
+    /* 5: multiply, perspective, TMU1 scaled differently */
+    grTexCombine(GR_TMU0, GR_COMBINE_FUNCTION_SCALE_OTHER, GR_COMBINE_FACTOR_LOCAL,
+                 GR_COMBINE_FUNCTION_LOCAL, GR_COMBINE_FACTOR_NONE, FXFALSE, FXFALSE);
+    quad(230, 240, 620, 460, 1.0f, 4.0f, 0.5f);
+    /* 6: paletted textures, a different palette in each TMU, multiplied */
+    grTexDownloadTable(GR_TMU0, GR_TEXTABLE_PALETTE, &palBase);
+    grTexDownloadTable(GR_TMU1, GR_TEXTABLE_PALETTE, &palLight);
+    grTexSource(GR_TMU0, base8Addr, GR_MIPMAPLEVELMASK_BOTH, &base8i);
+    grTexSource(GR_TMU1, light8Addr, GR_MIPMAPLEVELMASK_BOTH, &light8i);
+    grTexCombine(GR_TMU0, GR_COMBINE_FUNCTION_SCALE_OTHER, GR_COMBINE_FACTOR_LOCAL,
+                 GR_COMBINE_FUNCTION_LOCAL, GR_COMBINE_FACTOR_NONE, FXFALSE, FXFALSE);
+    quad(20, 425, 200, 475, 1.0f, 1.0f, 1.0f);
+    grTexSource(GR_TMU0, baseAddr, GR_MIPMAPLEVELMASK_BOTH, &base);
+    grTexSource(GR_TMU1, lightAddr, GR_MIPMAPLEVELMASK_BOTH, &light);
+
+    grBufferSwap(1);
+  }
+
+  grGlideShutdown();
+  return 0;
+}
