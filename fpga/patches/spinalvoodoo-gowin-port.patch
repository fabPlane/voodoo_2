diff --git a/emu/glide/swlibs/newpci/pcilib/fxsim.c b/emu/glide/swlibs/newpci/pcilib/fxsim.c
index d36865c..c4c27ab 100644
--- a/emu/glide/swlibs/newpci/pcilib/fxsim.c
+++ b/emu/glide/swlibs/newpci/pcilib/fxsim.c
@@ -298,8 +298,89 @@ static int simGetDebugLevel(void) {
 #define TEX_NUM_PAGES    (TEX_MEM_SIZE / TEX_PAGE_SIZE) /* 2048 */
 
 static unsigned char texDirtyPages[TEX_NUM_PAGES];
+/* One bit per word inside the dirty pages, so a small sub-image update
+ * sends only the words written rather than whole 4KB pages. */
+static FxU32 texDirtyWords[TEX_MEM_SIZE / 4 / 32];
 static int texHasDirty = 0;
 
+/* Texture upload dedupe. The card writes each aperture word to packed
+ * texture memory at an address that depends on textureMode / tLOD /
+ * texBaseAddr* (TextureMem.fromPciDrain + TexLayoutTables in the RTL). That
+ * translation is mirrored here, with a copy of what the card's texture
+ * memory holds, so a word the card already has is not sent again: the Mesa
+ * fx driver re-downloads evicted textures every frame when they do not all
+ * fit. VOODOO_TEX_NODEDUPE=1 sends everything. */
+/* Per TMU (index 1 only with SIM_DUAL_TMU): its layout registers, and its
+ * texture memory in the shadow (TMU1 is TEX_SHADOW_BYTES up). */
+static FxU32 texRegMode[2], texRegLod[2], texRegBase[2][4]; /* base, base1, base2, base3_8 */
+#define TEX_SHADOW_BYTES (1u << 22) /* the RTL masks packed addresses to 22 bits */
+static int simDualTmu(void);
+static FxU32 *texShadow;            /* card texture memory, by word */
+static FxU32 *texShadowValid;       /* one bit per word */
+static int texDedupe = -1;
+static unsigned long texSentWords, texSkippedWords;
+
+static FxU32 texLodSize(int lod, int aspect, int is16) {
+    int wide = 8 - lod > 0 ? 8 - lod : 0;
+    int narrow = 8 - aspect - lod > 0 ? 8 - aspect - lod : 0;
+    return 1u << (wide + narrow + is16);
+}
+
+/* Packed byte address of the 4 bytes an aperture word lands on, or -1 when
+ * the card drops the write. */
+static long texPackedAddr(FxU32 pciAddr) {
+    FxU32 lod = (pciAddr >> 17) & 0xf, t = (pciAddr >> 9) & 0xff, s, lodBase, shift;
+    int tmu = (pciAddr >> 21) & 3;
+    FxU32 *base;
+    int tformat, is16, seq8, aspect, sIsWider, multibase, k;
+    if (tmu > 1 || (tmu == 1 && !simDualTmu()) || lod > 8) return -1;
+    base = texRegBase[tmu];
+    tformat = (texRegMode[tmu] >> 8) & 0xf; is16 = tformat >= 8; seq8 = (texRegMode[tmu] >> 31) & 1;
+    aspect = (texRegLod[tmu] >> 21) & 3; sIsWider = (texRegLod[tmu] >> 20) & 1;
+    multibase = (texRegLod[tmu] >> 24) & 1;
+    if (is16) s = (pciAddr >> 1) & 0xfe;
+    else if (seq8) s = pciAddr & 0xfc;
+    else s = (pciAddr >> 1) & 0xfc;
+    {
+        int wide = 8 - (int)lod > 0 ? 8 - (int)lod : 0;
+        int narrow = 8 - aspect - (int)lod > 0 ? 8 - aspect - (int)lod : 0;
+        shift = sIsWider ? wide : narrow;
+    }
+    if (multibase && lod == 1) lodBase = (base[1] & 0x7ffff) << 3;
+    else if (multibase && lod == 2) lodBase = (base[2] & 0x7ffff) << 3;
+    else if (multibase && lod >= 3) {
+        lodBase = (base[3] & 0x7ffff) << 3;
+        for (k = 3; k < (int)lod; k++) lodBase += texLodSize(k, aspect, is16);
+    } else {
+        lodBase = (base[0] & 0x7ffff) << 3;
+        for (k = 0; k < (int)lod; k++) lodBase += texLodSize(k, aspect, is16);
+    }
+    if (is16) return ((lodBase + (s << 1) + (t << (shift + 1))) & (TEX_SHADOW_BYTES - 1)) + (long)tmu * TEX_SHADOW_BYTES;
+    return ((lodBase + s + (t << shift)) & (TEX_SHADOW_BYTES - 1)) + (long)tmu * TEX_SHADOW_BYTES;
+}
+
+/* 1 = send the word (and remember it), 0 = the card already holds it. */
+static int texNeedsSend(FxU32 pciAddr, FxU32 data) {
+    long a;
+    FxU32 w;
+    if (texDedupe < 0) {
+        texDedupe = getenv("VOODOO_TEX_NODEDUPE") == NULL;
+        if (texDedupe) {
+            texShadow = calloc(2 * TEX_SHADOW_BYTES / 4, sizeof(FxU32));
+            texShadowValid = calloc(2 * TEX_SHADOW_BYTES / 4 / 32, sizeof(FxU32));
+            if (!texShadow || !texShadowValid) texDedupe = 0;
+        }
+    }
+    if (!texDedupe) return 1;
+    a = texPackedAddr(pciAddr);
+    if (a < 0) return 1; /* dropped by the card anyway; keep its behaviour */
+    w = (FxU32)a >> 2;
+    if ((texShadowValid[w >> 5] >> (w & 31) & 1) && texShadow[w] == data) return 0;
+    texShadow[w] = data;
+    texShadowValid[w >> 5] |= 1u << (w & 31);
+    return 1;
+}
