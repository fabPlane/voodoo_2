+      for (lane <- 0 until 24) {
+        val addr = (lane / 8) * 0x10 + (lane % 8) * 2
+        dut.io.readReq.valid #= true
+        dut.io.readReq.address #= addr
+        dut.clockDomain.waitSamplingWhere(dut.io.readReq.ready.toBoolean)
+        dut.io.readReq.valid #= false
+        dut.clockDomain.waitSamplingWhere(dut.io.readRsp.valid.toBoolean)
+        assert(dut.io.readRsp.data.toLong == addr, f"lane 0x$addr%x")
+      }
+      assert(issued == 3)
+      assert(maxStalled < 32, s"memory response left unaccepted for $maxStalled cycles")
+    }
+  }
 }
