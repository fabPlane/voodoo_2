diff --git a/test/PciFifoSwapOrderTest.scala b/test/PciFifoSwapOrderTest.scala
new file mode 100644
index 0000000..344fd75
--- /dev/null
+++ b/test/PciFifoSwapOrderTest.scala
@@ -0,0 +1,130 @@
+//> using target.scope test
+
+package voodoo
+
+import org.scalatest.funsuite.AnyFunSuite
+import spinal.core._
+import spinal.core.sim._
+import voodoo.bus.{PciFifo, RegisterCategory}
+
+/** A swapbufferCMD holds everything queued behind it until the swap has happened. Front/back
+  * follow the completed swap count, so a triangle drained while the swap still waits for retrace
+  * would draw into the finished frame that is about to be shown (GLQuake: blocks of the next
+  * frame on screen while moving).
+  */
+class PciFifoSwapOrderTest extends AnyFunSuite {
+  private val triangleCmdAddr = 0x100
+  private val swapCmdAddr = 0x128
+  private val swapWaitCycles = 300
+
+  private def mkDut() = {
+    val c = Config.voodoo1()
+    PciFifo(
+      busParams = RegisterBank.bmbParams(c),
+      categories = Map(
+        BigInt(triangleCmdAddr) -> RegisterCategory.fifoNoSync,
+        BigInt(swapCmdAddr) -> RegisterCategory.fifoWithSync
+      ),
+      floatAliases = Map.empty,
+      commandAddresses = Seq(BigInt(triangleCmdAddr), BigInt(swapCmdAddr))
+    )
+  }
+
+  private def run(withSwap: Boolean): Unit =
+    SimConfig.withIVerilog.compile(mkDut()).doSim { dut =>
+      dut.clockDomain.forkStimulus(10)
+      dut.io.cpuSide.cmd.valid #= false
+      dut.io.cpuSide.cmd.last #= true
+      dut.io.cpuSide.cmd.opcode #= 1
+      dut.io.cpuSide.cmd.address #= 0
+      dut.io.cpuSide.cmd.data #= 0
+      dut.io.cpuSide.cmd.mask #= 0xf
+      dut.io.cpuSide.cmd.length #= 3
+      dut.io.cpuSide.cmd.source #= 0
+      dut.io.cpuSide.rsp.ready #= true
+      dut.io.regSide.cmd.ready #= true
+      dut.io.regSide.rsp.valid #= false
+      dut.io.regSide.rsp.last #= true
+      dut.io.regSide.rsp.opcode #= 0
+      dut.io.regSide.rsp.data #= 0
+      dut.io.regSide.rsp.source #= 0
+      dut.io.texWrite.valid #= false
+      dut.io.texWrite.pciAddr #= 0
+      dut.io.texWrite.data #= 0
+      dut.io.texWrite.mask #= 0xf
+      dut.io.texDrain.ready #= true
+      dut.io.pipelineBusy #= false
+      dut.io.swapBusy #= false
+      dut.io.commandReady.foreach(_ #= true)
+      dut.io.wasEnqueuedAddr #= swapCmdAddr
+      dut.clockDomain.waitSampling(4)
+
+      // SwapBuffer model, as wired in Core: a swap write reaching the register bank at
+      // cycle T shows up as swapbufferCmd.valid at T+1 (command stream m2sPipe), then
+      // SwapBuffer waits for retrace; swapBusy covers both.
+      var cycle = 0L
+      var swapDrained = -1L
+      var swapDone = -1L
+      var busyLeft = 0
+      var startDelay = 0
+      val triDrains = scala.collection.mutable.ArrayBuffer.empty[Long]
+      fork {
+        while (true) {
+          dut.clockDomain.waitSampling()
+          cycle += 1
+          if (startDelay > 0) {
+            startDelay -= 1
+            if (startDelay == 0) busyLeft = swapWaitCycles
+          } else if (busyLeft > 0) {
+            busyLeft -= 1
+            if (busyLeft == 0) swapDone = cycle
+          }
+          if (dut.io.regSide.cmd.valid.toBoolean && dut.io.regSide.cmd.ready.toBoolean &&
+              dut.io.regSide.cmd.opcode.toInt == 1) {
+            dut.io.regSide.cmd.address.toInt match {
+              case `swapCmdAddr`     => swapDrained = cycle; startDelay = 1
+              case `triangleCmdAddr` => triDrains += cycle
+              case _                 =>
+            }
+          }
+          dut.io.swapBusy #= busyLeft > 0
+        }
+      }
+
+      def write(addr: Int, data: Long): Unit = {
+        dut.io.cpuSide.cmd.valid #= true
+        dut.io.cpuSide.cmd.address #= addr
+        dut.io.cpuSide.cmd.data #= data
+        dut.clockDomain.waitSamplingWhere(dut.io.cpuSide.cmd.ready.toBoolean)
+        dut.io.cpuSide.cmd.valid #= false
+      }
+
+      if (withSwap) write(swapCmdAddr, 1) // vsync enabled
+      // The next frame's triangles, back to back behind the swap.
+      val triCount = 4
+      for (_ <- 0 until triCount) write(triangleCmdAddr, 0)
+
+      dut.clockDomain.waitSamplingWhere(triDrains.size == triCount || cycle > 4 * swapWaitCycles)
+      assert(triDrains.size == triCount, s"only ${triDrains.size} of $triCount triangle commands drained")
+      if (withSwap) {
+        assert(swapDrained >= 0, "swap command never reached the register bank")
+        assert(swapDone >= 0, "swap never completed")
+        for (at <- triDrains)
+          assert(
+            at > swapDone,
+            s"triangle command drained at cycle $at while the swap drained at $swapDrained " +
+              s"was still pending (done at $swapDone)"
+          )
+      } else {
+        assert(triDrains.head < swapWaitCycles / 10, "triangle commands stalled without a swap")
+      }
+    }
+
+  test("triangle commands wait for the swap queued before them") {
+    run(withSwap = true)
+  }
+
+  test("triangle commands drain without a preceding swap") {
+    run(withSwap = false)
+  }
+}
