diff --git a/test/ScanoutLineFetcherTest.scala b/test/ScanoutLineFetcherTest.scala
new file mode 100644
index 0000000..79c430a
--- /dev/null
+++ b/test/ScanoutLineFetcherTest.scala
@@ -0,0 +1,150 @@
+//> using target.scope test
+
+package voodoo
+
+import org.scalatest.funsuite.AnyFunSuite
+import spinal.core._
+import spinal.core.sim._
+import spinal.lib._
+import spinal.lib.bus.bmb._
+import voodoo.framebuffer.{FramebufferPlaneReader, ScanoutLineFetcher}
+import voodoo.hdmi.{HdmiCdcFramebufferScanout, VideoTiming}
+
+import scala.collection.mutable
+
+/** HdmiCdcFramebufferScanout fed by ScanoutLineFetcher, against a BMB memory
+  * model with random latency and command back-pressure: every HDMI frame
+  * must show the framebuffer pixel-exact, frame after frame, including lines
+  * that start or end on a half word (odd base address) and bursts that cross
+  * 256-byte pieces.
+  */
+class ScanoutLineFetcherTest extends AnyFunSuite {
+  case class Harness(c: Config, timing: VideoTiming, ahead: Int) extends Component {
+    val io = new Bundle {
+      val hdmiClock = in Bool ()
+      val hdmiReset = in Bool ()
+      val frontBase = in UInt (c.addressWidth.value bits)
+      val stride = in UInt (16 bits)
+      val mem = master(Bmb(FramebufferPlaneReader.bmbParams(c)))
+      val rgb = out Bits (24 bits)
+      val de = out Bool ()
+    }
+    val scan = HdmiCdcFramebufferScanout(c, timing, fifoDepth = 256, prefillLevel = 64, refillLowLevel = 96, refillHighLevel = 224,
+      prefetchAheadLines = ahead)
+    val fetch = ScanoutLineFetcher(c, fifoWords = 64, maxBurstBytes = 32)
+    scan.io.hdmiClock := io.hdmiClock
+    scan.io.hdmiReset := io.hdmiReset
+    scan.io.regs.frontBase := io.frontBase
+    scan.io.regs.backBase := 0
+    scan.io.regs.pixelStride := io.stride.resized
+    scan.io.regs.displayWidth := timing.activeWidth
+    scan.io.regs.displayHeight := timing.activeHeight
+    scan.io.regs.framebufferEnable := True
+    scan.io.regs.testPatternEnable := False
+    scan.io.regs.gammaWrite.setIdle() // reset table = identity
+    scan.io.prefetchReq >> fetch.io.prefetchReq
+    scan.io.readReq >> fetch.io.readReq
+    fetch.io.readRsp >> scan.io.readRsp
+    io.mem <> fetch.io.mem
+    io.rgb := scan.io.video.rgb.r ## scan.io.video.rgb.g ## scan.io.video.rgb.b
+    io.de := scan.io.video.de
+  }
+
+  /** Runs the scanout for 30 HDMI frames and returns, for each frame after
+    * the first three, whether it showed the framebuffer pixel-exact.
+    * Memory latency is `latency(rnd)` core cycles; `hdmiHalf` is half the
+    * HDMI clock period (the core clock period is 10).
+    */
+  def run(ahead: Int, timing: VideoTiming, base: Long, hdmiHalf: Int, cmdBusy: Boolean,
+      latency: scala.util.Random => Int): Seq[Boolean] = {
+    val c = Config.voodoo1()
+    var result: Seq[Boolean] = Nil
+    SimConfig.withIVerilog.compile(Harness(c, timing, ahead)).doSim(seed = 4) { dut =>
+      dut.clockDomain.forkStimulus(10)
+      fork { while (true) { dut.io.hdmiClock #= false; sleep(hdmiHalf); dut.io.hdmiClock #= true; sleep(hdmiHalf) } }
+      dut.io.hdmiReset #= true
+      val stride = 64 // hardware stride is in 64-pixel tiles
+      dut.io.frontBase #= base
+      dut.io.stride #= stride
+      // Pixel (x, y) -> red x+1, green y+1 (RGB565).
+      def pix(x: Int, y: Int): Int = (((x + 1) & 31) << 11) | ((y + 1) << 5)
+      val mem = mutable.HashMap[Long, Int]()
+      for (y <- 0 until timing.activeHeight; x <- 0 until timing.activeWidth) {
+        val a = base + 2L * (y * stride + x)
+        val w = a & ~3L
+        val old = mem.getOrElse(w, 0)
+        mem(w) = if ((a & 2) != 0) (old & 0xffff) | (pix(x, y) << 16) else (old & 0xffff0000) | pix(x, y)
+      }
+      val rnd = new scala.util.Random(9)
+      val pending = mutable.Queue[(Long, Int, Long)]() // addr, words, due
+      var cycle = 0L
+      dut.io.mem.cmd.ready #= false
+      dut.io.mem.rsp.valid #= false
+      fork {
+        var beat = 0
+        var rspValid = false
+        while (true) {
+          dut.clockDomain.waitSampling(); cycle += 1
+          if (dut.io.mem.cmd.valid.toBoolean && dut.io.mem.cmd.ready.toBoolean) {
+            val a = dut.io.mem.cmd.fragment.address.toLong
+            val words = (dut.io.mem.cmd.fragment.length.toInt + 1 + (a & 3).toInt + 3) / 4
+            assert((a & ~0xfffL) == ((a + 4 * words - 1) & ~0xfffL), "burst crosses a 4 KiB page")
+            pending.enqueue((a & ~3L, words, cycle + latency(rnd)))
+          }
+          dut.io.mem.cmd.ready #= !cmdBusy || rnd.nextInt(3) != 0
+          if (rspValid && dut.io.mem.rsp.ready.toBoolean) { rspValid = false; beat += 1
+            if (beat == pending.head._2) { pending.dequeue(); beat = 0 } }
+          if (!rspValid && pending.nonEmpty && pending.head._3 <= cycle) {
+            val (a, words, _) = pending.head
+            dut.io.mem.rsp.fragment.data #= mem.getOrElse(a + 4 * beat, 0) & 0xffffffffL
+            dut.io.mem.rsp.last #= beat == words - 1
+            rspValid = true
+          }
+          dut.io.mem.rsp.valid #= rspValid
+        }
+      }
+      dut.clockDomain.waitSampling(4)
+      dut.io.hdmiReset #= false
+      // Collect HDMI frames (sampled on the HDMI clock).
+      val frames = mutable.ArrayBuffer[Map[(Int, Int), (Int, Int)]]()
+      var cur = mutable.Map[(Int, Int), (Int, Int)]()
+      var prevDe = false; var inactive = 0; var x = 0; var y = -1
+      while (frames.size < 30) {
+        waitUntil(dut.io.hdmiClock.toBoolean == false); waitUntil(dut.io.hdmiClock.toBoolean)
+        sleep(1)
+        val de = dut.io.de.toBoolean
+        if (de && !prevDe) {
+          if (inactive > timing.hTotal) { if (y >= 0) frames += cur.toMap; cur = mutable.Map(); y = 0 } else y += 1
+          x = 0; inactive = 0
+        } else if (!de) inactive += 1
+        if (de) { val v = dut.io.rgb.toBigInt.toInt; cur((x, y)) = ((v >> 16) >> 3, ((v >> 8) & 0xff) >> 2); x += 1 }
+        prevDe = de
+      }
+      def exact(f: Map[(Int, Int), (Int, Int)]) =
+        (for (yy <- 0 until timing.activeHeight; xx <- 0 until timing.activeWidth) yield f.get((xx, yy)) == Some(((xx + 1) & 31, yy + 1))).forall(identity)
+      result = frames.drop(3).map(exact).toSeq
+    }
+    result
+  }
+
+  for (ahead <- Seq(1, 2)) test(s"scanout through the line fetcher shows every frame pixel-exact (ahead $ahead)") {
+    val timing = VideoTiming(activeWidth = 37, activeHeight = 6, hFrontPorch = 2, hSync = 2, hBackPorch = 3,
+      vFrontPorch = 1, vSync = 1, vBackPorch = 1)
+    // Odd pixel start: the first pixel is in the high half word.
+    val ok = run(ahead, timing, 0x10002L, hdmiHalf = 7, cmdBusy = true, latency = r => 3 + r.nextInt(12))
+    assert(ok.forall(identity), s"frames not exact: $ok")
+  }
+
+  // On the dock (GLQuake) the scanout underflowed mid-frame with one line
+  // announced at a time: each line then costs a full memory round trip plus
+  // its pixels, longer than an HDMI line. Two lines ahead hide the latency.
+  test("two lines ahead keep up where one line ahead underflows (memory latency > line slack)") {
+    val timing = VideoTiming(activeWidth = 40, activeHeight = 40, hFrontPorch = 2, hSync = 2, hBackPorch = 4,
+      vFrontPorch = 1, vSync = 1, vBackPorch = 1)
+    // HDMI line = 48 * 12 = 57.6 core cycles; one line ahead needs ~30 + 40.
+    val one = run(1, timing, 0x10000L, hdmiHalf = 6, cmdBusy = false, latency = _ => 30)
+    val two = run(2, timing, 0x10000L, hdmiHalf = 6, cmdBusy = false, latency = _ => 30)
+    assert(!one.forall(identity), s"one line ahead was expected to underflow: $one")
+    assert(two.forall(identity), s"two lines ahead underflowed: $two")
+  }
+}
diff --git a/test/TmuSmallTextureCacheTest.scala b/test/TmuSmallTextureCacheTest.scala
new file mode 100644
index 0000000..a41b150
--- /dev/null
+++ b/test/TmuSmallTextureCacheTest.scala
@@ -0,0 +1,157 @@
+//> using target.scope test
+
+package voodoo
+
+import org.scalatest.funsuite.AnyFunSuite
+import spinal.core._
+import spinal.core.sim._
+import voodoo.texture.TmuSmallTextureCache
+
+import scala.collection.mutable
+
+/** TmuSmallTextureCache against a word-addressed memory model: every tap of
+  * every sample must match memory as it was when the sample was requested,
+  * across line conflicts (a 16-line cache over 8 KiB), downloads that change
+  * memory and invalidate, and invalidates that land while a line is filling.
+  */
+class TmuSmallTextureCacheTest extends AnyFunSuite {
+  private val config = Config.voodoo1().copy(useTexFillCache = false, texSmallCacheLines = 16)
+
+  test("small texture cache returns current memory for random point and bilinear samples") {
+    SimConfig.withIVerilog.compile(TmuSmallTextureCache(config)).doSim(seed = 3) { dut =>
+      dut.clockDomain.forkStimulus(10)
+      val rnd = new scala.util.Random(5)
+      val mem = mutable.HashMap[Long, Long]() // word address -> data
+      var memGen = 0
+      def wordAt(a: Long): Long = mem.getOrElse(a, ((a * 2654435761L) ^ (memGen * 0x9e3779b9L)) & 0xffffffffL)
+
+      for (bt <- dut.io.sampleRequest.payload.flatten) bt match {
+        case b: Bool => b #= false
+        case b: BitVector => b #= 0
+        case _ =>
+      }
+      dut.io.sampleRequest.valid #= false
+      dut.io.sampleFetch.ready #= true
+      dut.io.invalidate #= false
+      dut.io.texRead.cmd.ready #= false
+      dut.io.texRead.rsp.valid #= false
+
+      // BMB memory: commands are accepted while earlier ones are still
+      // answered (in order, after a latency), 32-bit beats.
+      var fills = 0
+      val cmdQ = mutable.Queue[(Long, Long)]() // line address, cycle it may answer
+      var cycle = 0L
+      fork {
+        while (true) {
+          dut.io.texRead.cmd.ready #= cmdQ.size < 4 && rnd.nextInt(3) != 0
+          dut.clockDomain.waitSampling()
+          cycle += 1
+          if (dut.io.texRead.cmd.valid.toBoolean && dut.io.texRead.cmd.ready.toBoolean) {
+            val a = dut.io.texRead.cmd.fragment.address.toLong
+            val beats = (dut.io.texRead.cmd.fragment.length.toInt + 1) / 4
+            assert(a % 32 == 0 && beats == 8, s"fill of $beats beats at 0x${a.toHexString}")
+            fills += 1
+            cmdQ.enqueue((a, cycle + 8 + rnd.nextInt(16)))
+          }
+        }
+      }
+      fork {
+        while (true) {
+          if (cmdQ.nonEmpty && cmdQ.head._2 <= cycle) {
+            val a = cmdQ.dequeue()._1
+            val data = (0 until 8).map(i => wordAt(a / 4 + i))
+            for (i <- 0 until 8) {
+              dut.io.texRead.rsp.valid #= true
+              dut.io.texRead.rsp.fragment.data #= data(i)
+              dut.io.texRead.rsp.last #= i == 7
+              dut.clockDomain.waitSamplingWhere(dut.io.texRead.rsp.ready.toBoolean)
+            }
+            dut.io.texRead.rsp.valid #= false
+          } else dut.clockDomain.waitSampling()
+        }
+      }
+
+      def texel(addr: Long, is16: Boolean): Int = {
+        val w = wordAt(addr / 4)
+        val half = if ((addr & 2) != 0) (w >> 16) & 0xffff else w & 0xffff
+        if (is16) half.toInt
+        else {
+          val b = (if ((addr & 1) != 0) half >> 8 else half) & 0xff
+          (b << 8 | b).toInt
+        }
+      }
+
+      case class Sample(bilinear: Boolean, is16: Boolean, taps: Seq[Long]) {
+        // Memory is only changed while nothing is in flight, so the expected
+        // texels can be computed at request time.
+        val expect: Seq[Int] = if (bilinear) taps.map(texel(_, is16)) else Seq(texel(taps.head, is16), 0, 0, 0)
+      }
+      val expected = mutable.Queue[Sample]()
+      var checked = 0
+      fork {
+        while (true) {
+          dut.clockDomain.waitSampling()
+          if (dut.io.sampleFetch.valid.toBoolean && dut.io.sampleFetch.ready.toBoolean) {
+            assert(expected.nonEmpty, "sample without a request")
+            val e = expected.dequeue()
+            val got = dut.io.sampleFetch.payload.texels.map(_.toInt)
+            assert(dut.io.sampleFetch.payload.bilinear.toBoolean == e.bilinear)
+            assert(got == e.expect, s"sample $checked taps ${e.taps.map(_.toHexString)}: got ${got.map(_.toHexString)} exp ${e.expect.map(_.toHexString)}")
+            checked += 1
+          }
+          dut.io.sampleFetch.ready #= rnd.nextInt(4) != 0
+        }
+      }
+
+      var sent = 0
+      for (batch <- 0 until 12) {
+        // A download between batches: new memory contents and an invalidate.
+        if (batch % 3 == 2) {
+          memGen += 1
+          for (k <- 0 until 64) mem(rnd.nextInt(2048).toLong) = rnd.nextLong() & 0xffffffffL
+          dut.io.invalidate #= true
+          dut.clockDomain.waitSampling()
+          dut.io.invalidate #= false
+        }
+        // Odd batches walk along a span like the rasterizer; even ones jump.
+        val span = batch % 2 == 1
+        val fillsBefore = fills
+        var spanAddr = rnd.nextInt(4096).toLong & ~1L
+        for (_ <- 0 until 150) {
+          val bilinear = rnd.nextBoolean()
+          val is16 = if (span) true else rnd.nextBoolean()
+          val step = if (is16) 2 else 1
+          val base = if (span) { spanAddr += step; spanAddr } else rnd.nextInt(8192 - 600).toLong & ~1L
+          val row = if (span) 128L else if (rnd.nextBoolean()) 256L else 512L
+          val taps = Seq(base, base + step, base + row, base + row + step)
+          val s = Sample(bilinear, is16, taps)
+          dut.io.sampleRequest.payload.bilinear #= bilinear
+          dut.io.sampleRequest.payload.is16Bit #= is16
+          dut.io.sampleRequest.payload.pointAddr #= taps.head
+          dut.io.sampleRequest.payload.biAddr0 #= taps(0)
+          dut.io.sampleRequest.payload.biAddr1 #= taps(1)
+          dut.io.sampleRequest.payload.biAddr2 #= taps(2)
+          dut.io.sampleRequest.payload.biAddr3 #= taps(3)
+          dut.io.sampleRequest.valid #= true
+          expected.enqueue(s)
+          dut.clockDomain.waitSamplingWhere(dut.io.sampleRequest.ready.toBoolean)
+          dut.io.sampleRequest.valid #= false
+          sent += 1
+          // Invalidate with unchanged memory while lines are filling.
+          if (rnd.nextInt(40) == 0) {
+            dut.io.invalidate #= true
+            dut.clockDomain.waitSampling()
+            dut.io.invalidate #= false
+          }
+        }
+        dut.clockDomain.waitSamplingWhere(checked == sent && !dut.io.busy.toBoolean)
+        if (span) {
+          val spanFills = fills - fillsBefore
+          assert(spanFills < 40, s"span batch $batch took $spanFills line fills for 150 samples")
+        }
+      }
+      assert(checked == sent)
+      println(s"[small tex cache] $sent samples, $fills line fills, $cycle cycles")
+    }
+  }
+}
