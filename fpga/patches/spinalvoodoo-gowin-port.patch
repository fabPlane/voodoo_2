new file mode 100644
index 0000000..286b588
--- /dev/null
+++ b/src/voodoo/framebuffer/ScanoutLineFetcher.scala
@@ -0,0 +1,119 @@
+package voodoo.framebuffer
+
+import spinal.core._
+import spinal.lib._
+import spinal.lib.bus.bmb._
+import voodoo._
+
+/** HDMI scanout fetcher that reads whole lines in order, with no cache.
+  *
+  * Drop-in for the scanout's FramebufferPlaneReader (same prefetchReq /
+  * readReq / readRsp / mem contract as used by HdmiCdcFramebufferScanout):
+  * the scanout announces each line with a prefetchReq (first and last pixel
+  * byte address), then asks for its pixels one readReq at a time in order,
+  * and announces the next line only after the last readReq of this one.
+  * So the request addresses carry no information beyond the order: each
+  * line is read with plain BMB bursts in aligned pieces of up to 256 bytes
+  * (never crossing a 4 KiB page) into a word FIFO, and every readReq is
+  * answered with the next pixel. A burst is only issued when the FIFO has
+  * room for all of it, so responses are never back-pressured.
+  *
+  * The general cached reader stalled for good on the Tang dock under GLQuake
+  * load (scanout black while rendering continued); this has no such state.
+  */
+case class ScanoutLineFetcher(c: Config, fifoWords: Int = 512, maxBurstBytes: Int = 256) extends Component {
+  require(isPow2(fifoWords) && isPow2(maxBurstBytes) && maxBurstBytes >= 4)
+  val io = new Bundle {
+    val prefetchReq = slave(Stream(FramebufferPlaneReader.PrefetchReq(c)))
+    val readReq = slave(Stream(FramebufferPlaneBuffer.ReadReq(c)))
+    val readRsp = master(Stream(FramebufferPlaneBuffer.ReadRsp()))
+    val mem = master(Bmb(FramebufferPlaneReader.bmbParams(c)))
+  }
+  private val aw = c.addressWidth.value
+  private val burstLog2 = log2Up(maxBurstBytes)
+
+  val words = StreamFifo(Bits(32 bits), fifoWords)
+
+  // ---- fetch side: one line at a time, aligned bursts
+  val fetch = new Area {
+    val active = RegInit(False)
+    val addr = Reg(UInt(aw bits)) init (0) // next word-aligned byte address
+    val endWord = Reg(UInt(aw bits)) init (0) // last word-aligned byte address
+    // Words requested but not yet popped by the pixel side.
+    val credit = Reg(UInt(log2Up(fifoWords + 1) + 1 bits)) init (0)
+
+    val toBurstEnd = (U(maxBurstBytes, burstLog2 + 1 bits) - addr(burstLog2 - 1 downto 0).resize(burstLog2 + 1))
+    val toLineEnd = (endWord - addr + 4).resize(aw)
+    val pieceBytes = UInt(burstLog2 + 1 bits)
+    pieceBytes := Mux(toLineEnd < toBurstEnd.resize(aw), toLineEnd.resize(burstLog2 + 1), toBurstEnd)
+    val pieceWords = (pieceBytes >> 2).resize(credit.getWidth)
+    val room = credit + pieceWords <= fifoWords
+
+    io.mem.cmd.valid := active && room
+    io.mem.cmd.fragment.opcode := Bmb.Cmd.Opcode.READ
+    io.mem.cmd.fragment.address := addr.resized
+    io.mem.cmd.fragment.length := (pieceBytes - 1).resized
+    io.mem.cmd.fragment.source := 0
+    io.mem.cmd.fragment.data := 0
+    io.mem.cmd.fragment.mask := 0
+    io.mem.cmd.last := True
+    if (io.mem.cmd.fragment.context.getWidth > 0) io.mem.cmd.fragment.context := 0
+
+    when(io.mem.cmd.fire) {
+      addr := addr + pieceBytes.resized
+      when(pieceBytes.resize(aw) === toLineEnd) { active := False }
+    }
+  }
+
+  words.io.push.valid := io.mem.rsp.valid
+  words.io.push.payload := io.mem.rsp.fragment.data
+  io.mem.rsp.ready := True // the credit guarantees FIFO room
+
+  // ---- pixel side: per line, the first pixel's half and the pixel count
+  case class LineInfo() extends Bundle {
+    val firstHalf = Bool()
+    val pixels = UInt(12 bits)
+  }
+  val lines = StreamFifo(LineInfo(), 4)
+
+  io.prefetchReq.ready := !fetch.active && lines.io.push.ready
+  lines.io.push.valid := io.prefetchReq.fire
+  lines.io.push.firstHalf := io.prefetchReq.startAddress(1)
+  lines.io.push.pixels := ((io.prefetchReq.endAddress - io.prefetchReq.startAddress) >> 1).resize(12) + 1
+  when(io.prefetchReq.fire) {
+    fetch.active := True
+    fetch.addr := io.prefetchReq.startAddress(aw - 1 downto 2) @@ U"00"
+    fetch.endWord := io.prefetchReq.endAddress(aw - 1 downto 2) @@ U"00"
+  }
+
+  val pix = new Area {
+    val started = RegInit(False)
+    val half = Reg(Bool()) init (False)
+    val left = Reg(UInt(12 bits)) init (0)
+    val curHalf = Mux(started, half, lines.io.pop.firstHalf)
+    val curLeft = Mux(started, left, lines.io.pop.pixels)
+    val word = words.io.pop.payload
+    val have = lines.io.pop.valid && words.io.pop.valid
+
+    io.readRsp.valid := have && io.readReq.valid
+    io.readRsp.data := Mux(curHalf, word(31 downto 16), word(15 downto 0))
+    io.readReq.ready := have && io.readRsp.ready
+
+    val take = io.readRsp.fire
+    val lastPixel = curLeft === 1
+    // Pop the word after its high half, or after the line's last pixel.
