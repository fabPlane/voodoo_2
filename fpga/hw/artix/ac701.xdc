# Physical constraints for AMD Artix-7 AC701 (XC7A200T-2FBG676).
# Pin names from LiteX litex_boards.platforms.xilinx_ac701.

set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 16 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property INTERNAL_VREF 0.750 [get_iobanks 33]
set_property INTERNAL_VREF 0.750 [get_iobanks 34]
set_property INTERNAL_VREF 0.750 [get_iobanks 35]

# 200 MHz differential system clock (MIG)
set_property PACKAGE_PIN R3 [get_ports clk200_p]
set_property PACKAGE_PIN P3 [get_ports clk200_n]
set_property IOSTANDARD DIFF_SSTL15 [get_ports clk200_p]
set_property IOSTANDARD DIFF_SSTL15 [get_ports clk200_n]
create_clock -period 5.000 -name clk200 [get_ports clk200_p]

# 156.25 MHz oscillator (HDMI MMCM)
set_property PACKAGE_PIN M21 [get_ports clk156_p]
set_property PACKAGE_PIN M22 [get_ports clk156_n]
set_property IOSTANDARD LVDS_25 [get_ports clk156_p]
set_property IOSTANDARD LVDS_25 [get_ports clk156_n]
create_clock -period 6.400 -name clk156 [get_ports clk156_p]

# CPU_RESET is active-high (UG952 / LiteX cpu_reset)
set_property PACKAGE_PIN U4 [get_ports cpu_reset]
set_property IOSTANDARD SSTL15 [get_ports cpu_reset]

# PCIe Gen2 x4
set_property PACKAGE_PIN M20 [get_ports pcie_rst_n]
set_property IOSTANDARD LVCMOS25 [get_ports pcie_rst_n]
set_property PACKAGE_PIN F11 [get_ports pcie_clk_p]
set_property PACKAGE_PIN E11 [get_ports pcie_clk_n]
create_clock -period 10.000 -name pcie_clk [get_ports pcie_clk_p]

set_property PACKAGE_PIN D10 [get_ports {pci_exp_txp[0]}]
set_property PACKAGE_PIN B9  [get_ports {pci_exp_txp[1]}]
set_property PACKAGE_PIN D8  [get_ports {pci_exp_txp[2]}]
set_property PACKAGE_PIN B7  [get_ports {pci_exp_txp[3]}]
set_property PACKAGE_PIN D12 [get_ports {pci_exp_rxp[0]}]
set_property PACKAGE_PIN B13 [get_ports {pci_exp_rxp[1]}]
set_property PACKAGE_PIN D14 [get_ports {pci_exp_rxp[2]}]
set_property PACKAGE_PIN B11 [get_ports {pci_exp_rxp[3]}]

# LEDs (LiteX user_led 0..3)
set_property PACKAGE_PIN M26 [get_ports {led[0]}]
set_property PACKAGE_PIN T24 [get_ports {led[1]}]
set_property PACKAGE_PIN T25 [get_ports {led[2]}]
set_property PACKAGE_PIN R26 [get_ports {led[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[*]}]

# HDMI / ADV7511 parallel RGB (LiteX "hdmi", UG952 D4-D11 / D16-D23 / D28-D35)
set_property PACKAGE_PIN AA24 [get_ports {hdmi_d[0]}]
set_property PACKAGE_PIN Y25  [get_ports {hdmi_d[1]}]
set_property PACKAGE_PIN Y26  [get_ports {hdmi_d[2]}]
set_property PACKAGE_PIN V26  [get_ports {hdmi_d[3]}]
set_property PACKAGE_PIN W26  [get_ports {hdmi_d[4]}]
set_property PACKAGE_PIN W25  [get_ports {hdmi_d[5]}]
set_property PACKAGE_PIN W24  [get_ports {hdmi_d[6]}]
set_property PACKAGE_PIN U26  [get_ports {hdmi_d[7]}]
set_property PACKAGE_PIN U25  [get_ports {hdmi_d[8]}]
set_property PACKAGE_PIN V24  [get_ports {hdmi_d[9]}]
set_property PACKAGE_PIN U20  [get_ports {hdmi_d[10]}]
set_property PACKAGE_PIN W23  [get_ports {hdmi_d[11]}]
set_property PACKAGE_PIN W20  [get_ports {hdmi_d[12]}]
set_property PACKAGE_PIN U24  [get_ports {hdmi_d[13]}]
set_property PACKAGE_PIN Y20  [get_ports {hdmi_d[14]}]
set_property PACKAGE_PIN V23  [get_ports {hdmi_d[15]}]
set_property PACKAGE_PIN AA23 [get_ports {hdmi_d[16]}]
set_property PACKAGE_PIN AA25 [get_ports {hdmi_d[17]}]
set_property PACKAGE_PIN AB25 [get_ports {hdmi_d[18]}]
set_property PACKAGE_PIN AC24 [get_ports {hdmi_d[19]}]
set_property PACKAGE_PIN AB24 [get_ports {hdmi_d[20]}]
set_property PACKAGE_PIN Y22  [get_ports {hdmi_d[21]}]
set_property PACKAGE_PIN Y23  [get_ports {hdmi_d[22]}]
set_property PACKAGE_PIN V22  [get_ports {hdmi_d[23]}]
set_property PACKAGE_PIN AB26 [get_ports hdmi_de]
set_property PACKAGE_PIN V21  [get_ports hdmi_clk]
set_property PACKAGE_PIN AC26 [get_ports hdmi_vs]
set_property PACKAGE_PIN AA22 [get_ports hdmi_hs]
set_property IOSTANDARD LVCMOS18 [get_ports {hdmi_*}]

# Board I2C (PCA9548 mux) — HDMI is channel 5
set_property PACKAGE_PIN N18 [get_ports i2c_scl]
set_property PACKAGE_PIN K25 [get_ports i2c_sda]
set_property PACKAGE_PIN R17 [get_ports i2c_mux_reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports i2c_scl]
set_property IOSTANDARD LVCMOS33 [get_ports i2c_sda]
set_property IOSTANDARD LVCMOS33 [get_ports i2c_mux_reset_n]

# DDR3 SODIMM, 32-bit (LiteX lanes 0-3). MIG also consumes these.
set_property PACKAGE_PIN M4  [get_ports {ddr3_addr[0]}]
set_property PACKAGE_PIN J3  [get_ports {ddr3_addr[1]}]
set_property PACKAGE_PIN J1  [get_ports {ddr3_addr[2]}]
set_property PACKAGE_PIN L4  [get_ports {ddr3_addr[3]}]
set_property PACKAGE_PIN K5  [get_ports {ddr3_addr[4]}]
set_property PACKAGE_PIN M7  [get_ports {ddr3_addr[5]}]
set_property PACKAGE_PIN K1  [get_ports {ddr3_addr[6]}]
set_property PACKAGE_PIN M6  [get_ports {ddr3_addr[7]}]
set_property PACKAGE_PIN H1  [get_ports {ddr3_addr[8]}]
set_property PACKAGE_PIN K3  [get_ports {ddr3_addr[9]}]
set_property PACKAGE_PIN N7  [get_ports {ddr3_addr[10]}]
set_property PACKAGE_PIN L5  [get_ports {ddr3_addr[11]}]
set_property PACKAGE_PIN L7  [get_ports {ddr3_addr[12]}]
set_property PACKAGE_PIN N6  [get_ports {ddr3_addr[13]}]
set_property PACKAGE_PIN L3  [get_ports {ddr3_addr[14]}]
set_property PACKAGE_PIN K2  [get_ports {ddr3_addr[15]}]
set_property PACKAGE_PIN N1  [get_ports {ddr3_ba[0]}]
set_property PACKAGE_PIN M1  [get_ports {ddr3_ba[1]}]
set_property PACKAGE_PIN H2  [get_ports {ddr3_ba[2]}]
set_property PACKAGE_PIN P1  [get_ports ddr3_ras_n]
set_property PACKAGE_PIN T4  [get_ports ddr3_cas_n]
set_property PACKAGE_PIN R1  [get_ports ddr3_we_n]
set_property PACKAGE_PIN T3  [get_ports ddr3_cs_n]
set_property PACKAGE_PIN AC6 [get_ports {ddr3_dm[0]}]
set_property PACKAGE_PIN AC4 [get_ports {ddr3_dm[1]}]
set_property PACKAGE_PIN AA3 [get_ports {ddr3_dm[2]}]
set_property PACKAGE_PIN U7  [get_ports {ddr3_dm[3]}]
set_property PACKAGE_PIN AB6 [get_ports {ddr3_dq[0]}]
set_property PACKAGE_PIN AA8 [get_ports {ddr3_dq[1]}]
set_property PACKAGE_PIN Y8  [get_ports {ddr3_dq[2]}]
