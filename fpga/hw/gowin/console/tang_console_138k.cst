// Physical constraints for Sipeed Tang Retro Console 138K
// (GW5AST-LV138PG484A, device version C). HDMI / clock / LED pins from
// working Console 138K cores (C64Nano / nand2mario). DDR3 pins come from
// the Gowin DDR3 IP for this package — do not copy the Pro Dock CST.

IO_LOC "clk50" V22;
IO_PORT "clk50" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF;

IO_LOC "led_n[0]" G11;
IO_LOC "led_n[1]" U12;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "tmds_clk_p" G15,G16;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_data_p[0]" J14,H14;
IO_PORT "tmds_data_p[0]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_data_p[1]" J15,H15;
IO_PORT "tmds_data_p[1]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;
IO_LOC "tmds_data_p[2]" K17,J17;
IO_PORT "tmds_data_p[2]" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33D;

// UART to BL616 (TangCore): USB HID pads arrive as command 0x09.
IO_LOC "uart_rx" V14;
IO_LOC "uart_tx" U15;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Onboard keys (active low). USER cycles the menu, RESET launches.
IO_LOC "key0_n" AA13;
IO_PORT "key0_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "key1_n" AB13;
IO_PORT "key1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

// Soft-USB Type-C (silkscreen S1, schematic J17).  The full-speed GPIO
// SoftPHY belongs on USB_TERM_RXDP/RXDN, which reach connector D+/D- through
// R130/R131 (3 Ω).  USB_DX J19/H19 is the separate analog-HS path.  Driving
// the GPIO PHY there does not produce a valid attachment on this board.
IO_LOC "usb_soft_dp" J16;
IO_PORT "usb_soft_dp" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "usb_soft_dn" AB16;
IO_PORT "usb_soft_dn" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "usb_pullup_en" M17;
IO_PORT "usb_pullup_en" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;

// Both x16 DDR3 chips. Gowin does not copy IO_TYPE from bit [0] onto the
// rest of a bus, so every pin needs SSTL15.
IO_LOC "O_ddr_addr[0]" M1;
IO_PORT "O_ddr_addr[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[1]" K2;
IO_PORT "O_ddr_addr[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[2]" G2;
IO_PORT "O_ddr_addr[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[3]" J4;
IO_PORT "O_ddr_addr[3]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "O_ddr_addr[4]" J2;
