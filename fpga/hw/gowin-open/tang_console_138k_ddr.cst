IO_LOC "ddr_dqs_p[0]" Y3;
IO_LOC "ddr_dqs_n[0]" AA3;
IO_LOC "ddr_dqs_p[1]" V9;
IO_LOC "ddr_dqs_n[1]" V8;
IO_PORT "ddr_dqs_p[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_dqs_n[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_dqs_p[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
