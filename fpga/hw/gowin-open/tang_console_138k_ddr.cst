// Tang Retro Console 138K DDR3 pins, PG484.
// Same balls LiteX uses for GW5AST-138C: the first x16 chip
// (MT41J256M16). This is not the Tang Mega 138K Pro FPG676 32-bit map.
// The second x16 chip is not in that map and is left unconnected here.
// CK and DQS are complementary SSTL15 pins. The packer rejects SSTL15D in
// the same bank as SSTL15.

IO_LOC "clk50" V22;
IO_PORT "clk50" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF;

IO_LOC "led_n[0]" G11;
IO_LOC "led_n[1]" U12;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "ddr_clk_p" L3;
IO_LOC "ddr_clk_n" K3;
IO_PORT "ddr_clk_p" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_clk_n" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;

IO_LOC "ddr_cke" K6;
IO_LOC "ddr_odt" M2;
IO_LOC "ddr_reset_n" L6;
IO_LOC "ddr_cs_n" P4;
IO_LOC "ddr_ras_n" L5;
IO_LOC "ddr_cas_n" L4;
IO_LOC "ddr_we_n" M5;
IO_PORT "ddr_cke" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_odt" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_reset_n" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_cs_n" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_ras_n" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_cas_n" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_we_n" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;

IO_LOC "ddr_a[0]" M1;
IO_LOC "ddr_a[1]" K2;
IO_LOC "ddr_a[2]" G2;
IO_LOC "ddr_a[3]" J4;
IO_LOC "ddr_a[4]" J2;
IO_LOC "ddr_a[5]" H2;
IO_LOC "ddr_a[6]" G3;
IO_LOC "ddr_a[7]" J1;
IO_LOC "ddr_a[8]" J5;
IO_LOC "ddr_a[9]" H5;
IO_LOC "ddr_a[10]" L1;
IO_LOC "ddr_a[11]" H3;
IO_LOC "ddr_a[12]" K4;
IO_LOC "ddr_a[13]" K1;
IO_LOC "ddr_a[14]" D1;
IO_PORT "ddr_a[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[3]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[4]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[5]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[6]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[7]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[8]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[9]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[10]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[11]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[12]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[13]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_a[14]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;

IO_LOC "ddr_ba[0]" P5;
IO_LOC "ddr_ba[1]" P2;
IO_LOC "ddr_ba[2]" M6;
IO_PORT "ddr_ba[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_ba[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;
IO_PORT "ddr_ba[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=12 BANK_VCCIO=1.5;

IO_LOC "ddr_dm[0]" AA4;
IO_LOC "ddr_dm[1]" V7;
IO_PORT "ddr_dm[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_dm[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;

IO_LOC "ddr_dq[0]" Y4;
IO_LOC "ddr_dq[1]" AB3;
IO_LOC "ddr_dq[2]" AA5;
IO_LOC "ddr_dq[3]" V4;
IO_LOC "ddr_dq[4]" AA1;
IO_LOC "ddr_dq[5]" AB2;
IO_LOC "ddr_dq[6]" AB5;
IO_LOC "ddr_dq[7]" AB1;
IO_LOC "ddr_dq[8]" AA8;
IO_LOC "ddr_dq[9]" Y8;
IO_LOC "ddr_dq[10]" AB7;
IO_LOC "ddr_dq[11]" Y7;
IO_LOC "ddr_dq[12]" AB8;
IO_LOC "ddr_dq[13]" W9;
IO_LOC "ddr_dq[14]" AB6;
IO_LOC "ddr_dq[15]" Y9;
IO_PORT "ddr_dq[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_dq[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_dq[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_dq[3]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_dq[4]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
