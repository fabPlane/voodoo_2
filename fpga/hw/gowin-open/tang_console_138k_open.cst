// Minimal open-source-flow constraints for the Tang Retro Console 138K.
// Device: GW5AST-LV138PG484AC1/I0 (GW5AST-138C).

IO_LOC "clk50" V22;
IO_PORT "clk50" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF;

IO_LOC "led_n[0]" G11;
IO_LOC "led_n[1]" U12;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "key0_n" AA13;
IO_LOC "key1_n" AB13;
IO_PORT "key0_n" IO_TYPE=LVCMOS33 PULL_MODE=UP HYSTERESIS=ON DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "key1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP HYSTERESIS=ON DRIVE=OFF BANK_VCCIO=3.3;

// UART between FPGA and the TangCore BL616.
IO_LOC "uart_rx" V14;
IO_LOC "uart_tx" U15;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// HDMI connector. The open flow names both halves of each differential pair;
// the Gowin project expresses the same pins as one comma-separated pair.
IO_LOC "tmds_clk_p" G15;
IO_LOC "tmds_clk_n" G16;
IO_LOC "tmds_data_p[0]" J14;
IO_LOC "tmds_data_n[0]" H14;
IO_LOC "tmds_data_p[1]" J15;
IO_LOC "tmds_data_n[1]" H15;
IO_LOC "tmds_data_p[2]" K17;
IO_LOC "tmds_data_n[2]" J17;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE;
IO_PORT "tmds_clk_n" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE;
IO_PORT "tmds_data_n[0]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE;
IO_PORT "tmds_data_n[1]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE;
IO_PORT "tmds_data_n[2]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE;
